# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos (Prisma). Local: Postgres de Supabase CLI.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Auth (local: `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""          # solo servidor

# Dominio base y cookies. Local: lvh.me resuelve a 127.0.0.1 con subdominios.
APP_BASE_DOMAIN="lvh.me:3000"
APP_PROTOCOL="http"
COOKIE_DOMAIN=".lvh.me"
APP_SECRET=""                          # 32+ caracteres; firma tokens (QR, justificar)

# Correo (Nodemailer). Local: Mailpit de Supabase. Piloto: Amazon SES SMTP.
SMTP_HOST="127.0.0.1"
SMTP_PORT="54325"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM_ADDRESS="avisos@khipuescolar.pe"
EMAIL_DAILY_LIMIT="2000"
EMAIL_RATE_PER_SECOND="1"
# --- Gmail (piloto): reemplaza el bloque de Mailpit de arriba (docs/despliegue.md §Correo) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="cuenta@gmail.com"          # cuenta con verificación en 2 pasos
# SMTP_PASS=""                           # contraseña de aplicación de 16 caracteres (no la clave de la cuenta)
# EMAIL_FROM_ADDRESS="cuenta@gmail.com"  # debe ser igual a SMTP_USER
# EMAIL_DAILY_LIMIT="450"                # Gmail permite ~500 correos/día
CRON_SECRET=""                         # protege /api/cron/*; Vercel lo envía como «Authorization: Bearer <CRON_SECRET>» (docs/despliegue.md)
SES_SNS_TOPIC_ARN=""                   # eventos de SES (entregado/rebote/apertura)

# Web Push (generar con: pnpm exec web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@khipuescolar.pe"

# Cloudinary (luego S3). Vacío en local = almacenamiento en disco (.uploads/).
STORAGE_PROVIDER="local"               # local | cloudinary | s3
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Amazon S3 (o compatible). Con STORAGE_PROVIDER="s3". Migrar: pnpm tsx --conditions=react-server scripts/migrar-archivos.ts --de cloudinary --a s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                         # opcional: MinIO, R2…
S3_PUBLIC_BASE_URL=""                  # opcional: CDN o dominio para archivos públicos (logo)
