# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos (Prisma). Local: Postgres de Supabase CLI.
# En trabajo paralelo, cada worktree usa una base local propia (DATABASE_URL y,
# si aplica, DIRECT_URL) y un puerto distinto: W1 3061, W2 3062, W3 3063,
# W4 3064. Ver docs/documentos-plan-implementacion.md §Entornos.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Auth (local: `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""          # solo servidor

# Dominio base y cookies. Local: lvh.me resuelve a 127.0.0.1 con subdominios.
APP_BASE_DOMAIN="lvh.me:3000"
APP_PROTOCOL="http"
COOKIE_DOMAIN=".lvh.me"
APP_SECRET=""                          # 32+ caracteres; firma tokens (QR, justificar)

# Correo (Nodemailer). Local: Mailpit de Supabase. Piloto: Amazon SES SMTP.
SMTP_HOST="127.0.0.1"
SMTP_PORT="54325"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Remitente de los avisos: usa una dirección del dominio definitivo (dominio por confirmar). Obligatorio en producción.
EMAIL_FROM_ADDRESS="avisos@example.invalid"
EMAIL_DAILY_LIMIT="2000"
EMAIL_RATE_PER_SECOND="1"
# Pool SMTP: por defecto activo si hay SMTP_USER (SES/Gmail) e inactivo en local. SMTP_POOL="true"|"false" lo fuerza.
# SMTP_MAX_CONNECTIONS="3"   # Gmail corta con más de ~3
# SMTP_MAX_MESSAGES="100"    # mensajes por conexión antes de reabrirla
# --- Gmail (piloto): reemplaza el bloque de Mailpit de arriba (docs/despliegue.md §Correo) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="cuenta@gmail.com"          # cuenta con verificación en 2 pasos
# SMTP_PASS=""                           # contraseña de aplicación de 16 caracteres (no la clave de la cuenta)
# EMAIL_FROM_ADDRESS="cuenta@gmail.com"  # debe ser igual a SMTP_USER
# EMAIL_DAILY_LIMIT="450"                # Gmail permite ~500 correos/día
CRON_SECRET=""                         # protege /api/cron/*; Vercel lo envía como «Authorization: Bearer <CRON_SECRET>» (docs/despliegue.md)
SES_SNS_TOPIC_ARN=""                   # eventos de SES (entregado/rebote/apertura)

# Web Push (generar con: pnpm exec web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto VAPID (mailto: o https:) del dominio definitivo (dominio por confirmar). Obligatorio en producción.
VAPID_SUBJECT="mailto:soporte@example.invalid"

# App en Google Play como TWA (opcional; docs/app-tiendas.md). Sirven /.well-known/assetlinks.json; vacío si faltan.
# Huellas SHA-256 del certificado de firma, separadas por comas (la de subida y la de «Firma de apps de Google Play»).
ANDROID_PACKAGE_NAME=""
ANDROID_SHA256_FINGERPRINTS=""

# Cloudinary (luego S3). Vacío en local = almacenamiento en disco (.uploads/).
STORAGE_PROVIDER="local"               # local | cloudinary | s3
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Amazon S3 (o compatible). Con STORAGE_PROVIDER="s3". Migrar: pnpm tsx --conditions=react-server scripts/migrar-archivos.ts --de cloudinary --a s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                         # opcional: MinIO, R2…
S3_PUBLIC_BASE_URL=""                  # opcional: CDN o dominio para archivos públicos (logo)

# Nudito (specs/41): adaptadores de IA reales. HOY NO SE USAN (todo es simulado). Solo se activan si existe la variable
# Y la configuración de plataforma «nudito_plus:proveedor» elige ese proveedor. No pongas claves en el repositorio.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
