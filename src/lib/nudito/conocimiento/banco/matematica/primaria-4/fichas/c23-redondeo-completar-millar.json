    ],
    "bloque": "Números hasta 10 000",
    "nombre": "Completar al millar más cercano",
    "disciplina": "aritmetica",
    "descripcionCorta": "Calcula mentalmente cuánto falta a un número para llegar al siguiente millar.",
    "palabrasClave": [
      "completar",
      "millar",
      "cercano"
    ],
    "prerrequisitos": [
      "mat.p4.equivalencias-um-c-d-u"
    ],
    "ordenSugerido": 11,
    "ideaCentral": "Para completar un número hasta el siguiente millar, busca primero el próximo múltiplo de 1000 que sea mayor. La diferencia entre ese millar y el número inicial es lo que falta.",
    "pasos": [
      "Identifica entre qué dos millares está el número.",
      "Elige el siguiente millar mayor.",
      "Resta el número inicial de ese millar.",
      "Comprueba sumando la diferencia al número inicial."
    ],
    "ejemplos": [
      {
        "situacion": "¿Cuánto falta de 2700 a 3000?",
        "desarrollo": "3000 − 2700 = 300.",
        "respuesta": "Faltan 300."
      },
      {
        "situacion": "¿Cuánto falta de 4580 al siguiente millar?",
        "desarrollo": "El siguiente es 5000; 5000 − 4580 = 420.",
        "respuesta": "Faltan 420."
      }
    ],
    "erroresFrecuentes": [
      {
        "error": "Restar desde el millar anterior.",
        "correccion": "La meta es el siguiente millar mayor que el número dado."
      },
      {
        "error": "Responder el millar de llegada en vez de la diferencia.",
        "correccion": "La pregunta pide cuánto falta, no a qué número se llega."
      }
    ],
    "vocabulario": [
      {
        "termino": "Siguiente millar",
        "significado": "Primer múltiplo de 1000 mayor que el número actual."
      },
      {
        "termino": "Complemento",
        "significado": "Cantidad que falta para llegar a la meta."
      },
      {
        "termino": "Diferencia",
        "significado": "Resultado de restar el número actual a la meta."
      }
    ],
