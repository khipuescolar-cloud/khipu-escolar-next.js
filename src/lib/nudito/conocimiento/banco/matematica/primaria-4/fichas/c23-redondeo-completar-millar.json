    "ideaCentral": "Redondear es aproximar un número a una decena, centena o millar cercano. Mira la cifra inmediatamente a la derecha de la posición elegida: de 0 a 4 se conserva y de 5 a 9 se aumenta una unidad.",
    "pasos": [
      "Decide si redondeas a decenas, centenas o millares.",
      "Ubica la cifra de esa posición.",
      "Mira la cifra siguiente a la derecha.",
      "Conserva o aumenta la cifra elegida y cambia las posteriores por cero."
    ],
    "ejemplos": [
      {
        "situacion": "Redondea 3467 a la centena.",
        "desarrollo": "La centena es 4 y la decena siguiente es 6; se aumenta a 5.",
        "respuesta": "3500."
      },
      {
        "situacion": "Redondea 7824 al millar.",
        "desarrollo": "La centena es 8, así que el millar 7 sube a 8.",
        "respuesta": "8000."
      }
    ],
    "erroresFrecuentes": [
      {
        "error": "Mirar la cifra de la izquierda para decidir.",
        "correccion": "La cifra que decide está justo a la derecha de la posición que redondeas."
      },
      {
        "error": "Conservar cifras después de la posición redondeada.",
        "correccion": "Todas las cifras a la derecha se vuelven cero."
      }
    ],
    "vocabulario": [
      {
        "termino": "Redondear",
        "significado": "Aproximar a una unidad de orden elegida."
      },
      {
        "termino": "Decena cercana",
        "significado": "Múltiplo de diez más cercano según la regla de redondeo."
      },
      {
        "termino": "Millar cercano",
        "significado": "Múltiplo de mil al que se aproxima el número."
      }
    ],
