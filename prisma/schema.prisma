enum EstadoTarea {
  borrador
  publicada
  cerrada
  archivada
}

enum EstadoEntregaTarea {
  asignada
  en_proceso
  entregada
  devuelta
  revisada
}

model EventoAgenda {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  salonId     String?    @map("salon_id") @db.Uuid // null = todo el colegio
  titulo      String
