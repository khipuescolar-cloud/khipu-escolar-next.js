// Esquema de Khipu Escolar. Documentación por módulo en specs/.
// Toda tabla de negocio lleva tenantId. El acceso pasa SIEMPRE por src/lib/server (db.forTenant).
// RLS está activado en todas las tablas y cerrado para anon/authenticated (ver migración rls_cerrado).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

/// Planes institucionales (specs/03): Khipu Base y Khipu Pro. Se venden completos.
enum Plan {
  base
  pro
}

enum Rol {
  direccion
  profesor
  apoderado
  alumno
  porteria
  administrativo // personal no docente (secretaría, auxiliares, psicología…)
}

enum NivelCompartidoDocumento {
  lector
  editor
}

enum AmbitoDocumento {
  biblioteca
  unidad
}

enum TipoIdentificacion {
  dni
  ce // carné de extranjería
  pasaporte
}

enum EstadoMembresia {
  activa
  invitada
  inactiva
}

enum EstadoTenant {
  activo
  piloto
  suspendido
}

enum ModoAvisos {
  todos
  solo_excepciones
}

enum EscalaCalificacion {
  literal
  vigesimal
}

/// Si Khipu sugiere la calificación del periodo y cómo (specs/11). Por defecto `ninguna`: el profesor la pone mirando sus
/// notas. `promedio` y `frecuente` son reglas PROVISIONALES (no validadas con docentes) que dirección puede activar.
enum SugerenciaPeriodo {
  ninguna
  promedio
  frecuente

  @@map("CalculoLiteral")
}

/// Estado de una evaluación (specs/11): `programada` = registrada o anunciada; sus notas son borrador y la familia no las ve.
/// `publicada` = resultados visibles para la familia. El cierre del curso o del periodo la deja «cerrada».
enum EstadoEvaluacion {
  programada
  publicada
}

enum OrigenCompetencia {
  oficial
  personalizada
}

/// Escala de un criterio de un instrumento (rúbrica o lista de cotejo).
enum EscalaCriterio {
  puntaje
  cumple
}

/// Instrumento con que se recoge la evidencia de una evaluación (specs/11).
enum InstrumentoEvaluacion {
  prueba_escrita
  lista_cotejo
  rubrica
  ficha_observacion
  otro
}

enum Nivel {
  inicial
  primaria
  secundaria
  academia
}

enum EstadoAlumno {
  activo
  retirado
}

enum EstadoAsistencia {
  llego
  tarde
  falta
  problema
}

enum OrigenAsistencia {
  lista
  porteria
  automatico // falta del día que pone el control de ingreso (specs/05)
  incidencia // falta a clase por una incidencia o retiro anticipado (specs/37)
}

enum TipoAviso {
  asistencia
  resumen_llegadas
  mensaje
  comunicado
  invitacion
  justificacion
  tarea
  alerta_direccion
  libreta
  soporte
  reunion // convocatoria, cambio o acta de una reunión (specs/32)
  documento // documento nuevo en la biblioteca (specs/31)
  nudito // Nudito+: licencia, alerta o resumen para la familia (specs/28–29)
}

enum CanalAviso {
  correo
  push
}

enum EstadoAviso {
  pendiente
  enviando // reservado por un worker; evita envíos duplicados
  enviado
  entregado
  abierto
  rebotado
  queja
  error
  omitido
}

/// Para el trato en la interfaz («Tutora» / «Tutor»). Opcional.
enum Genero {
  femenino
  masculino
  no_especifica
}

/// Estado académico de una nota sin calificación (specs/37). NSP = «No se presentó» (faltó a la clase, lo pone la
/// asistencia); no_entrego = asistió pero no entregó (lo marca el profesor). Nunca se guarda como 0 ni entra en cálculos.
enum MarcaNota {
  nsp
  no_entrego
}

/// Decisión del profesor sobre la recuperación de una actividad con NSP justificado (specs/37).
enum EstadoRecuperacion {
  autorizada
  denegada
}

/// Tipo de cambio en el historial de una nota (specs/37).
enum TipoCambioNota {
  registro // cambio en borrador (antes de publicar)
  correccion_digitacion
  recuperacion
  cambio_asistencia
  consecuencia_vencimiento
  otra
  decision_recuperacion
}

enum TipoIncidencia {
  accidente
  salud
  otro
}

enum EstadoRectificacion {
  pendiente
  aprobada
  rechazada
}

enum EstadoJustificacion {
  pendiente
  aceptada
  rechazada
}

enum ProveedorArchivo {
  local
  cloudinary
  s3
}

enum TipoPeriodo {
  bimestre
  trimestre
  semestre
}

enum CalificacionLiteral {
  AD
  A
  B
  C
}

enum TipoEvento {
  evento
  reunion
  examen
  feriado
  actividad
}

enum TipoDocumento {
  reglamento
  horario
  calendario
  otro
}

enum AutorNudito {
  usuario
  nudito
}

// ───────────────────────────── Núcleo ─────────────────────────────

model Tenant {
  id                              String               @id @default(uuid()) @db.Uuid
  slug                            String               @unique
  nombre                          String
  ciudad                          String?
  eslogan                         String?
  plan                            Plan                 @default(base)
  emailDomains                    String[]             @default([]) @map("email_domains")
  logoArchivoId                   String?              @map("logo_archivo_id") @db.Uuid
  horaEnvioAvisos                 String               @default("09:00") @map("hora_envio_avisos") // HH:mm, resumen de llegadas
  horaLimiteTardanza              String               @default("08:00") @map("hora_limite_tardanza") // HH:mm, desde esta hora la llegada es «tarde»
  /// Control de ingreso automático (specs/05): a `horaLimiteTardanza` avisa «aún no llega» a las familias de quienes no
  /// registran ingreso; a `horaLimiteFalta` les pone falta del día con enlace para justificar. Además, en las listas de curso
  /// un alumno sin ingreso al colegio solo puede quedar con falta.
  controlIngresoAutomatico        Boolean              @default(false) @map("control_ingreso_automatico")
  horaLimiteFalta                 String               @default("09:00") @map("hora_limite_falta") // HH:mm, desde esta hora sin ingreso = falta
  zonaHoraria                     String               @default("America/Lima") @map("zona_horaria")
  /// HH:mm. Horas laborales del personal: ventana para buscar disponibilidad de reuniones (specs/40).
  horaInicioLaboral               String               @default("07:30") @map("hora_inicio_laboral")
  horaFinLaboral                  String               @default("16:30") @map("hora_fin_laboral")
  /// Las familias pueden solicitar reuniones al tutor y a los profesores del salón de su hijo (specs/40).
  familiasSolicitanReuniones      Boolean              @default(true) @map("familias_solicitan_reuniones")
  modoAvisos                      ModoAvisos           @default(todos) @map("modo_avisos")
  escalaCalificacion              EscalaCalificacion   @default(literal) @map("escala_calificacion")
  sugerenciaPeriodo               SugerenciaPeriodo    @default(ninguna) @map("calculo_literal")
  /// Plazo para justificar una falta, en días CALENDARIO desde el día de la falta (día 0); vence a las 23:59:59 del último
  /// día en la zona del colegio (specs/07, specs/37).
  plazoJustificacionDias          Int                  @default(15) @map("plazo_justificacion_dias")
  /// Consecuencia configurada cuando vence el plazo sin justificación (specs/37). Según la escala del colegio: literal o
  /// numérica. Ambas null = sin configurar (Khipu no inventa un valor: alerta a dirección).
  consecuenciaVencimientoLiteral  CalificacionLiteral? @map("consecuencia_vencimiento_literal")
  consecuenciaVencimientoNumerica Decimal?             @map("consecuencia_vencimiento_numerica") @db.Decimal(4, 2)
  /// HH:mm. Hora del resumen académico diario a las familias (specs/37).
  horaResumenAcademico            String               @default("18:00") @map("hora_resumen_academico")
  /// Grado de primaria (1–6) desde el que un alumno puede tener cuenta propia. Secundaria siempre; inicial nunca (specs/10).
  gradoMinimoCuentaAlumno         Int                  @default(5) @map("grado_minimo_cuenta_alumno")
  /// Tareas (specs/39): máximo de archivos y MB por archivo en materiales y entregas. Techo duro en código: 5 y 10
  /// (5 × 10 MB cabe en el `bodySizeLimit` de 55 MB de las server actions).
  tareasMaxArchivos               Int                  @default(5) @map("tareas_max_archivos")
  tareasMaxMb                     Int                  @default(10) @map("tareas_max_mb")
  /// Niveles con asistencia por curso (specs/04): los profesores pasan lista de sus cursos solo en salones de estos niveles.
  /// La asistencia al colegio (`ambito = "dia"`: portería o lista del tutor) no depende de esto.
  asistenciaPorCursoNiveles       Nivel[]              @default([]) @map("asistencia_por_curso_niveles")
  estado                          EstadoTenant         @default(activo)
  createdAt                       DateTime             @default(now()) @map("created_at") @db.Timestamptz

  memberships           Membership[]
  salones               Salon[]
  cursos                Curso[]
  alumnos               Alumno[]
  apoderadosAlumnos     ApoderadoAlumno[]
  consentimientos       Consentimiento[]
  auditoria             Auditoria[]
  asistencias           Asistencia[]
  controlesIngreso      ControlIngresoDia[]
  enviosAviso           EnvioAviso[]
  avisos                Aviso[]
  justificacionTokens   JustificacionToken[]
  justificaciones       Justificacion[]
  archivos              Archivo[]
  // @@W1
  almacenamiento         AlmacenamientoColegio?
  usoAlmacenamiento      UsoAlmacenamientoCategoria[]
  subidasArchivo         SubidaArchivo[]
  metricasAlmacenamiento MetricaAlmacenamientoDia[]

  // @@W2
  materialesClase MaterialClase[]
  materialSecciones MaterialSeccion[]
  materialVersiones MaterialVersion[]
  materialVersionArchivos MaterialVersionArchivo[]
  carpetasMaterial CarpetaMaterial[]
  tareaMateriales TareaMaterial[]

  // @@W3
  solicitudesDocumentales SolicitudDocumental[]
  solicitudDestinatarios SolicitudDestinatario[]
  solicitudVersiones SolicitudVersion[]
  solicitudVersionArchivos SolicitudVersionArchivo[]
  solicitudEventos SolicitudEvento[]
  conversaciones        Conversacion[]
  mensajes              Mensaje[]
  comunicados           Comunicado[]
  preferenciasAviso     PreferenciaAviso[]
  carnetsQr             CarnetQr[]
  periodos              Periodo[]
  competencias          Competencia[]
  evaluaciones          Evaluacion[]
  notas                 Nota[]
  calificacionesPeriodo CalificacionPeriodo[]
  tareas                Tarea[]
  tareaCursos           TareaCurso[]
  tareaAsignaciones     TareaAsignacion[]
  tareaEntregas         TareaEntrega[]
  tareaComentarios      TareaComentario[]
  tareaEnlaces          TareaEnlace[]
  tareaCambiosPlazo     TareaCambioPlazo[]
  eventosAgenda         EventoAgenda[]
  documentosColegio     DocumentoColegio[]
  nuditoConversaciones  NuditoConversacion[]
  nuditoMensajes        NuditoMensaje[]
  exportaciones         ExportacionColegio[]
  accesosSoporte        AccesoSoporte[]
  cierresCurso          CierreCurso[]
  informesProgreso      InformeProgreso[]
  enviosInformeProgreso EnvioInformeProgreso[]
  historialNotas        HistorialNota[]
  comentariosTutor      ComentarioTutor[]
  criteriosEvaluacion   CriterioEvaluacion[]
  resultadosCriterio    ResultadoCriterio[]
  modulosAjustados      TenantModulo[]
  contactos             ContactoColegio[]
  suscripcion           Suscripcion?
  pagos                 PagoRegistro[]
  feriados              FeriadoExtra[]
  ticketsSoporte        TicketSoporte[]
  mensajesSoporte       MensajeSoporte[]
  // Khipu Pro completo (specs/30–33) y Nudito+ (specs/28–29)
  capacidades           Capacidad[]
  desempenos            Desempeno[]
  evaluacionDesempenos  EvaluacionDesempeno[]
  carpetasDocumento     CarpetaDocumento[]
  documentos            Documento[]
  compartidosDocumento  CompartidoDocumento[]
  destacadosDocumento   DestacadoDocumento[]
  accesosDocumento      AccesoDocumento[]
  reuniones             Reunion[]
  reunionInvitados      ReunionInvitado[]
  reunionCambios        ReunionCambio[]
  reunionAcuerdos       ReunionAcuerdo[]
  reservasAgenda        ReservaAgenda[]
  bloqueosAgenda        BloqueoAgenda[]
  horariosAtencion      HorarioAtencion[]
  licenciasNudito       LicenciaNudito[]
  pagosNudito           PagoNudito[]
  consentimientosIa     ConsentimientoIa[]
  usosNudito            UsoNudito[]
  alertasNudito         AlertaNudito[]
  resumenesNudito       ResumenNudito[]
  // Nudito, tutor de Khipu Pro (specs/41–44)
  nuditoConfig          NuditoConfigColegio?
  nuditoTemasColegio    NuditoTemaColegio[]
  nuditoSesiones        NuditoSesion[]
  nuditoEjercicios      NuditoEjercicio[]
  nuditoIntentos        NuditoIntento[]
  nuditoDominios        NuditoDominio[]
  nuditoDominioEventos  NuditoDominioEvento[]
  nuditoConsumosIa      NuditoConsumoIa[]
  // Horario semanal por salón (specs/34)
  horarioPeriodos       HorarioPeriodo[]
  plantillasHorario     PlantillaHorario[]
  bloquesHorario        BloqueHorario[]
  // NSP, justificaciones, incidencias, libretas emitidas y resumen académico (specs/37)
  incidencias           Incidencia[]
  permisosAsistencia    PermisoAsistencia[]
  incidenciaCursos      IncidenciaCurso[]
  libretasEmitidas      LibretaEmitida[]
  rectificaciones       RectificacionLibreta[]
  resumenesAcademicos   ResumenAcademicoDia[]
  eventosAcademicos     EventoAcademico[]
  notificaciones        Notificacion[]

  @@map("tenants")
}

/// Usuario global. id = auth.users.id de Supabase.
model Profile {
  id                  String              @id @db.Uuid
  email               String              @unique
  nombres             String
  apellidos           String              @default("")
  telefono            String?
  genero              Genero?
  tipoDocumento       TipoIdentificacion? @map("tipo_documento")
  numeroDocumento     String?             @map("numero_documento")
  fechaNacimiento     DateTime?           @map("fecha_nacimiento") @db.Date
  direccion           String?
  /// true mientras use la contraseña inicial (su DNI): se le obliga a cambiarla al entrar.
  debeCambiarPassword Boolean             @default(false) @map("debe_cambiar_password")
  ultimoIngresoAt     DateTime?           @map("ultimo_ingreso_at") @db.Timestamptz
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  memberships       Membership[]
  pushSuscripciones PushSuscripcion[]

  adminPlataforma AdminPlataforma?

  @@index([numeroDocumento])
  @@map("profiles")
}

/// Rol de un usuario dentro de un colegio. Un usuario puede tener varias.
model Membership {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  rol       Rol
  estado    EstadoMembresia @default(activa)
  cargo     String? // «Director(a) general», «Secretaria», «Docente de Matemática»…
  gestionaCompetencias Boolean @default(false) @map("gestiona_competencias")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  salonesTutor             Salon[]                @relation("TutorSalon")
  cursosDictados           Curso[]                @relation("ProfesorCurso")
  hijos                    ApoderadoAlumno[]
  consentimientos          Consentimiento[]
  asistenciasRegistradas   Asistencia[]           @relation("RegistradoPor")
  enviosCreados            EnvioAviso[]           @relation("EnviosCreados")
  avisos                   Aviso[]
  justificacionTokens      JustificacionToken[]
  justificaciones          Justificacion[]        @relation("JustificacionApoderado")
  justificacionesRevisadas Justificacion[]        @relation("JustificacionRevisor")
  conversacionesProfesor   Conversacion[]         @relation("ConversacionProfesor")
  conversacionesApoderado  Conversacion[]         @relation("ConversacionApoderado")
  mensajes                 Mensaje[]
  comunicados              Comunicado[]
  preferenciaAviso         PreferenciaAviso?
  notasRegistradas         Nota[]
  tareasCreadas            Tarea[]
  tareasEntregadasPor      TareaAsignacion[]      @relation("TareaEntregadaPor")
  tareaEntregasEnviadas    TareaEntrega[]         @relation("TareaEntregaEnviadaPor")
  tareaComentarios         TareaComentario[]      @relation("TareaComentarioAutor")
  compartidosRecibidos     CompartidoDocumento[]   @relation("DestinatarioDocumento")
  compartidosCreados       CompartidoDocumento[]   @relation("CreadorCompartidoDocumento")
  destacadosDocumento      DestacadoDocumento[]
  accesosDocumento         AccesoDocumento[]
  tareaComentariosOcultos  TareaComentario[]      @relation("TareaComentarioOculto")
  tareaCambiosPlazo        TareaCambioPlazo[]     @relation("TareaCambioPlazoAutor")
  eventosCreados           EventoAgenda[]
  nuditoConversaciones     NuditoConversacion[]
  ticketsSoporte           TicketSoporte[]        @relation("TicketsCreados")
  alumnoVinculado          Alumno?                @relation("CuentaAlumno")
  cierresCurso             CierreCurso[]
  informesProgreso         InformeProgreso[]
  enviosInformeProgreso    EnvioInformeProgreso[]
  historialNotas           HistorialNota[]
  comentariosTutor         ComentarioTutor[]
  resultadosCriterio       ResultadoCriterio[]
  carpetasCreadas          CarpetaDocumento[]
  documentosPublicados     Documento[]
  // @@W1
  subidasArchivo         SubidaArchivo[]

  // @@W2
  materialesCreados MaterialClase[] @relation("AutorMaterial")
  carpetasMaterialCreadas CarpetaMaterial[] @relation("AutorCarpetaMaterial")
  versionesMaterial MaterialVersion[] @relation("AutorVersionMaterial")
  materialesEnTareas TareaMaterial[] @relation("AutorTareaMaterial")

  // @@W3
  solicitudesCreadas SolicitudDocumental[] @relation("SolicitudCreador")
  solicitudesRecibidas SolicitudDestinatario[] @relation("SolicitudReceptor")
  versionesPresentadas SolicitudVersion[] @relation("VersionPresentador")
  versionesRevisadas SolicitudVersion[] @relation("VersionRevisor")
  eventosSolicitud SolicitudEvento[] @relation("EventoActor")
  reunionesConvocadas      Reunion[]              @relation("ReunionConvocante")
  reunionesOrganizadas     Reunion[]              @relation("ReunionOrganizador")
  invitacionesReunion      ReunionInvitado[]
  cambiosReunion           ReunionCambio[]        @relation("ReunionCambioActor")
  acuerdosReunion          ReunionAcuerdo[]       @relation("AcuerdoResponsable")
  reservasAgenda           ReservaAgenda[]
  bloqueosAgenda           BloqueoAgenda[]        @relation("BloqueoDe")
  bloqueosRegistrados      BloqueoAgenda[]        @relation("BloqueoRegistradoPor")
  horariosAtencion         HorarioAtencion[]
  pagosNudito              PagoNudito[]
  consentimientosIa        ConsentimientoIa[]
  nuditoSesiones           NuditoSesion[]
  bloquesHorarioACargo     BloqueHorario[]
  recuperacionesDecididas  Nota[]                 @relation("RecuperacionDecidida")
  incidenciasRegistradas   Incidencia[]
  // Permisos de asistencia y salida en portería (specs/04, 05)
  permisosRegistrados      PermisoAsistencia[]    @relation("PermisoRegistradoPor")
  permisosAnulados         PermisoAsistencia[]    @relation("PermisoAnuladoPor")
  salidasRegistradas       Asistencia[]           @relation("SalidaRegistradaPor")
  libretasEmitidas         LibretaEmitida[]
  rectificacionesPedidas   RectificacionLibreta[] @relation("RectificacionSolicitada")
  rectificacionesResueltas RectificacionLibreta[] @relation("RectificacionResuelta")
  notificaciones           Notificacion[]
  competenciasDesactivadas Competencia[] @relation("CompetenciaDesactivadaPor")
  evaluacionesCreadas Evaluacion[] @relation("EvaluacionCreadaPor")

  @@unique([tenantId, userId, rol])
  @@index([userId])
  @@map("memberships")
}

model Salon {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  nombre      String // "3.° B"
  nivel       Nivel
  grado       Int?
  seccion     String?
  anio        Int
  tutorId     String?   @map("tutor_id") @db.Uuid
  /// Salón de un año cerrado: deja de listarse para pasar lista, pero conserva su historial.
  archivadoAt DateTime? @map("archivado_at") @db.Timestamptz
  /// Plantilla de horario (specs/34): horas del día y entrada/salida del salón; su entrada fija la tardanza (specs/05).
  plantillaId String?   @map("plantilla_id") @db.Uuid

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor       Membership?       @relation("TutorSalon", fields: [tutorId], references: [id], onDelete: SetNull)
  plantilla   PlantillaHorario? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  cursos      Curso[]
  alumnos     Alumno[]
  comunicados Comunicado[]
  eventos     EventoAgenda[]
  documentos  Documento[]
  compartidosDocumento CompartidoDocumento[]
  carpetasDocumento CarpetaDocumento[] @relation("CarpetaSalonDocumento")
  reuniones   Reunion[]
  bloques     BloqueHorario[]

  @@index([tenantId])
  @@map("salones")
}

model Curso {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  salonId        String  @map("salon_id") @db.Uuid
  nombre         String // "Matemática"
  profesorId     String? @map("profesor_id") @db.Uuid
  /// Clave del área en el catálogo CNEB (`src/lib/cneb`, p. ej. «matematica», «comunicacion», «ciencia-tecnologia»).
  /// Se deduce del nombre o de los desempeños importados; dirección puede fijarla a mano (specs/42).
  areaCneb       String? @map("area_cneb")
  /// true = la fijó dirección: ningún proceso automático la cambia.
  areaCnebManual Boolean @default(false) @map("area_cneb_manual")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salon                 Salon                  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  profesor              Membership?            @relation("ProfesorCurso", fields: [profesorId], references: [id], onDelete: SetNull)
  asistencias           Asistencia[]
  competencias          Competencia[]
  evaluaciones          Evaluacion[]
  tareas                Tarea[]
  tareaCursos           TareaCurso[]
  cierres               CierreCurso[]
  enviosInformeProgreso EnvioInformeProgreso[]
  bloques               BloqueHorario[]
  incidencias           IncidenciaCurso[]
  nuditoSesiones        NuditoSesion[]
  // @@W1

  // @@W2
  materialSecciones MaterialSeccion[]
  carpetasMaterial CarpetaMaterial[]

  // @@W3

  @@index([tenantId])
  @@index([profesorId])
  @@index([tenantId, areaCneb])
  @@map("cursos")
}

/// El menor NO necesita cuenta propia (se usa desde el grado que fije el colegio).
model Alumno {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  salonId         String       @map("salon_id") @db.Uuid
  nombres         String
  apellidos       String
  codigo          String?
