  materialId String @map("material_id") @db.Uuid
  numero Int
  nota String?
  creadaPorId String @map("creada_por") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  material MaterialClase @relation(fields: [materialId], references: [id], onDelete: Cascade)
  creadaPor Membership @relation("AutorVersionMaterial", fields: [creadaPorId], references: [id], onDelete: Restrict)
  archivos MaterialVersionArchivo[]
  tareas TareaMaterial[]

