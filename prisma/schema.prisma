// ──────────── Nudito: tablas del asistente retirado, reutilizadas por Nudito+ (specs/29) ────────────

/// Documentos del colegio que Nudito puede citar (reglamento, horario, calendario).
model DocumentoColegio {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tipo      TipoDocumento
  titulo    String
  contenido String
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, tipo])
  @@map("documentos_colegio")
}

/// Conversación con Nudito+ (tutor IA, specs/29). Solo el alumno conversa: con su cuenta (`modo = alumno`)
/// o dentro de la cuenta del apoderado (`modo = hijo`, alumnos sin cuenta propia). El apoderado NO ve las conversaciones.
model NuditoConversacion {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  /// Quién escribe: la cuenta del alumno (modo alumno) o la del apoderado que presta su sesión (modo hijo).
  membershipId String     @map("membership_id") @db.Uuid
  /// Alumno con la licencia. Obligatorio en conversaciones de Nudito+; null solo en filas antiguas del Nudito retirado.
  alumnoId     String?    @map("alumno_id") @db.Uuid
  modo         ModoNudito @default(alumno)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  alumno     Alumno?         @relation(fields: [alumnoId], references: [id], onDelete: SetNull)
  mensajes   NuditoMensaje[]
  alertas    AlertaNudito[]
  sesiones   NuditoSesion[]

  @@index([tenantId, membershipId])
  @@index([tenantId, alumnoId, createdAt])
  @@map("nudito_conversaciones")
}

model NuditoMensaje {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  conversacionId String      @map("conversacion_id") @db.Uuid
  autor          AutorNudito
  cuerpo         String
  intencion      String?
  derivado       Boolean     @default(false)
  acciones       Json? // botones de la respuesta (abrir_chat, elegir_hijo, ir)
  /// Tokens del proveedor de IA para este mensaje (solo respuestas de Nudito+); alimentan UsoNudito.
  tokensEntrada  Int?        @map("tokens_entrada")
  tokensSalida   Int?        @map("tokens_salida")
  /// true si el filtro de seguridad bloqueó el mensaje (del alumno o de la IA); puede generar una AlertaNudito.
  bloqueado      Boolean     @default(false)
  /// Sesión de tutoría en la que se escribió (pregunta o explicación dentro de la práctica, specs/41).
  sesionId       String?     @map("sesion_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversacion NuditoConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  sesion       NuditoSesion?      @relation(fields: [sesionId], references: [id], onDelete: SetNull)

  @@index([conversacionId, createdAt])
  @@index([sesionId, createdAt])
  @@map("nudito_mensajes")
}

// ───────────────────────── Plataforma (equipo Khipu) ─────────────────────────

/// Super administrador de la plataforma: crea colegios y ve reportes globales. No pertenece a ningún colegio.
/// Se crea solo por script (pnpm khipu:crear-superadmin), nunca desde la web.
model AdminPlataforma {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins_plataforma")
}

/// Auditoría de acciones de plataforma (crear colegio, cambiar plan, suspender, exportar, borrar).
model AuditoriaPlataforma {
  id        BigInt   @id @default(autoincrement())
  actorId   String   @map("actor_id") @db.Uuid
  accion    String
  tenantId  String?  @map("tenant_id") @db.Uuid // sin FK: debe sobrevivir al borrado del colegio
  detalle   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("auditoria_plataforma")
}

// ─── Pendientes v2 (2026-10-27) ──────────────────────────────────────────────

/// Cierre de notas de un curso en un periodo (además del cierre general del periodo).
model CierreCurso {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  periodoId    String   @map("periodo_id") @db.Uuid
  cursoId      String   @map("curso_id") @db.Uuid
  cerradoPorId String   @map("cerrado_por") @db.Uuid
  cerradoAt    DateTime @default(now()) @map("cerrado_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodo    Periodo    @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  curso      Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  cerradoPor Membership @relation(fields: [cerradoPorId], references: [id], onDelete: NoAction)

  @@unique([periodoId, cursoId])
  @@index([tenantId])
  @@map("cierres_curso")
}

enum EstadoExportacion {
  pendiente
  procesando
  lista
  error
}

/// Exportación del colegio armada en segundo plano por el cron (specs/15).
model ExportacionColegio {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  /// Perfil que la pidió (dirección del colegio o super administrador).
  solicitadoPorId String            @map("solicitado_por") @db.Uuid
  estado          EstadoExportacion @default(pendiente)
  archivoId       String?           @map("archivo_id") @db.Uuid
  error           String?
  intentos        Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  terminadoAt     DateTime?         @map("terminado_at") @db.Timestamptz

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  archivo Archivo? @relation(fields: [archivoId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([estado, createdAt])
  @@map("exportaciones_colegio")
}

/// Acceso temporal del super administrador a un colegio para dar soporte (specs/16). Siempre auditado.
model AccesoSoporte {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  motivo    String
  inicioAt  DateTime  @default(now()) @map("inicio_at") @db.Timestamptz
  expiraAt  DateTime  @map("expira_at") @db.Timestamptz
  cerradoAt DateTime? @map("cerrado_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, inicioAt])
  @@index([adminId, expiraAt])
  @@map("accesos_soporte")
}

// ─── Panel de plataforma v2 (2026-10-28): catálogo de planes, roles, responsables, suscripciones ───

/// Catálogo comercial de cada plan (specs/19). El código del plan sigue siendo el enum `Plan`.
model PlanCatalogo {
  plan                Plan     @id
  nombre              String // «Khipu Base», «Khipu Pro»
  descripcion         String?
  /// Precio por alumno al mes en soles (referencial; el precio real va en la suscripción del colegio).
  precioPorAlumno     Decimal? @map("precio_por_alumno") @db.Decimal(8, 2)
  precioMinimoMensual Decimal? @map("precio_minimo_mensual") @db.Decimal(10, 2)
  maxAlumnos          Int?     @map("max_alumnos")
  orden               Int      @default(0)
  activo              Boolean  @default(true) // si es false no se ofrece a colegios nuevos
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  modulos PlanModulo[]

  @@map("planes_catalogo")
}

/// Módulos que incluye cada plan. `modulo` es una clave de `FEATURES` (src/lib/planes.ts).
model PlanModulo {
  plan   Plan
  modulo String

  catalogo PlanCatalogo @relation(fields: [plan], references: [plan], onDelete: Cascade)

  @@id([plan, modulo])
  @@map("plan_modulos")
}

/// Roles por defecto de todos los colegios: qué módulos ve cada rol. Solo se guardan las celdas
/// cambiadas respecto del comportamiento del código (sin fila = habilitado si el código lo permite).
model RolModulo {
  rol        Rol
  modulo     String
  habilitado Boolean
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([rol, modulo])
  @@map("rol_modulos")
}

/// Ajuste de módulos de un colegio sobre su plan: `habilitado=true` agrega un módulo extra; `false` lo quita.
model TenantModulo {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  modulo     String
  habilitado Boolean
  motivo     String?
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, modulo])
  @@map("tenant_modulos")
}

enum TipoContacto {
  principal
  direccion_academica
  administrativo
  facturacion
  tecnico
  otro
}

/// Responsables y contactos del colegio (puede haber varios; uno es el principal).
/// Si tiene acceso al sistema, `membershipId` apunta a su membresía (normalmente rol dirección).
model ContactoColegio {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  tipo         TipoContacto
  nombres      String
  apellidos    String       @default("")
  cargo        String?
  email        String
  telefono     String?
  principal    Boolean      @default(false)
  membershipId String?      @map("membership_id") @db.Uuid
  notas        String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("contactos_colegio")
}

enum CicloFacturacion {
  mensual
  anual
}

enum EstadoSuscripcion {
  prueba
  activa
  suspendida
  cancelada
}

/// Contrato comercial del colegio (registro manual; no hay pasarela de pagos).
model Suscripcion {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @unique @map("tenant_id") @db.Uuid
  plan               Plan
  ciclo              CicloFacturacion  @default(mensual)
  estado             EstadoSuscripcion @default(prueba)
  moneda             String            @default("PEN")
  /// Monto por ciclo acordado con el colegio.
  montoPorCiclo      Decimal           @map("monto_por_ciclo") @db.Decimal(10, 2)
  alumnosContratados Int?              @map("alumnos_contratados")
  inicio             DateTime          @db.Date
  proximaRenovacion  DateTime          @map("proxima_renovacion") @db.Date
  notas              String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([proximaRenovacion])
  @@map("suscripciones")
}

/// Pago recibido de un colegio (registro manual del equipo Khipu).
model PagoRegistro {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  monto           Decimal  @db.Decimal(10, 2)
  moneda          String   @default("PEN")
  fechaPago       DateTime @map("fecha_pago") @db.Date
  periodoDesde    DateTime @map("periodo_desde") @db.Date
  periodoHasta    DateTime @map("periodo_hasta") @db.Date
  metodo          String // transferencia, yape, plin, depósito, otro
  comprobante     String? // número de boleta/factura
  registradoPorId String   @map("registrado_por") @db.Uuid // perfil del super administrador
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fechaPago])
  @@map("pagos_registro")
}

enum NivelAnuncio {
  info
  novedad
  mantenimiento
  urgente
}

enum AudienciaAnuncio {
  direccion
  personal // dirección, profesores, administrativos, portería
  todos // también familias y alumnos
}

/// Anuncio del equipo Khipu a los colegios (franja en su panel entre `desde` y `hasta`).
model AnuncioPlataforma {
  id          String           @id @default(uuid()) @db.Uuid
  titulo      String
  cuerpo      String
  nivel       NivelAnuncio     @default(info)
  audiencia   AudienciaAnuncio @default(direccion)
  /// Vacío = todos los colegios; si no, solo estos planes.
  planes      Plan[]           @default([])
  desde       DateTime         @db.Timestamptz
  hasta       DateTime         @db.Timestamptz
  creadoPorId String           @map("creado_por") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([desde, hasta])
  @@map("anuncios_plataforma")
}

/// Días no laborables además de los feriados nacionales fijos (src/lib/dias-habiles.ts):
/// feriados regionales, días decretados por el gobierno o días propios de un colegio (`tenantId`).
model FeriadoExtra {
  id        String   @id @default(uuid()) @db.Uuid
  fecha     DateTime @db.Date
  nombre    String
  /// null = todo el país (o la región indicada); con valor = solo ese colegio.
  tenantId  String?  @map("tenant_id") @db.Uuid
  region    String? // p. ej. «Cusco»; null = nacional
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@map("feriados_extra")
}

/// Ajustes globales de la plataforma (clave → valor JSON). P. ej. última ejecución de crons.
model ConfigPlataforma {
  clave     String   @id
  valor     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("config_plataforma")
}

// ─── Mesa de ayuda: chat colegio ↔ equipo Khipu (specs/23) ───────────────────

enum CategoriaTicket {
  duda
  problema
  sugerencia
  facturacion
  cuentas_accesos
  otro
}

enum PrioridadTicket {
  baja
  normal
  alta
  urgente
}

enum EstadoTicket {
  abierto // nuevo, sin respuesta de Khipu
  en_progreso // Khipu lo está atendiendo
  esperando_colegio // Khipu respondió y espera al colegio
  resuelto // Khipu lo dio por resuelto (el colegio puede reabrir)
  cerrado // cerrado definitivamente
}

enum AutorSoporte {
  colegio
  khipu
  sistema // cambios de estado y asignación
}

/// Conversación de soporte de un colegio con el equipo Khipu.
model TicketSoporte {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  asunto               String
  categoria            CategoriaTicket @default(duda)
  prioridad            PrioridadTicket @default(normal)
  estado               EstadoTicket    @default(abierto)
  /// Membresía de quien la abrió (dirección o quien tenga el módulo «soporte»).
  creadoPorId          String          @map("creado_por") @db.Uuid
  /// Perfil del super administrador asignado (sin FK: el equipo vive en admins_plataforma).
  asignadoAId          String?         @map("asignado_a") @db.Uuid
  ultimoMensajeAt      DateTime        @default(now()) @map("ultimo_mensaje_at") @db.Timestamptz
  primeraRespuestaAt   DateTime?       @map("primera_respuesta_at") @db.Timestamptz
  resueltoAt           DateTime?       @map("resuelto_at") @db.Timestamptz
  /// Hasta cuándo leyó cada lado (contadores de no leídos).
  leidoColegioHasta    DateTime?       @map("leido_colegio_hasta") @db.Timestamptz
  leidoKhipuHasta      DateTime?       @map("leido_khipu_hasta") @db.Timestamptz
  /// Valoración del colegio (1–5) y comentario opcional.
  valoracion           Int?
  comentarioValoracion String?         @map("comentario_valoracion")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creadoPor Membership       @relation("TicketsCreados", fields: [creadoPorId], references: [id], onDelete: NoAction)
  mensajes  MensajeSoporte[]

  @@index([tenantId, ultimoMensajeAt])
  @@index([estado, ultimoMensajeAt])
  @@index([asignadoAId])
  @@map("tickets_soporte")
}

/// Mensaje de una conversación de soporte. `interno = true`: nota del equipo Khipu que el colegio no ve.
model MensajeSoporte {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  ticketId  String       @map("ticket_id") @db.Uuid
  autor     AutorSoporte
  /// Perfil de quien escribe; null en mensajes del sistema.
  autorId   String?      @map("autor_id") @db.Uuid
  cuerpo    String
  interno   Boolean      @default(false)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket   TicketSoporte @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adjuntos Archivo[]

  @@index([ticketId, createdAt])
  @@map("mensajes_soporte")
}

// ─── Landing: solicitudes de demo de colegios interesados (specs/25) ─────────

enum EstadoSolicitud {
  nueva
  contactada
  demo_agendada
  convertida // se creó el colegio
  descartada
}

/// Pedido de demo enviado desde la landing pública. Global (aún no hay colegio).
model SolicitudDemo {
  id          String          @id @default(uuid()) @db.Uuid
  nombre      String
  cargo       String?
  colegio     String
  ciudad      String?
  correo      String
  telefono    String?
  alumnos     Int? // tamaño aproximado del colegio
  mensaje     String?
  /// Plan de interés si vino desde la sección de planes.
  planInteres Plan?           @map("plan_interes")
  estado      EstadoSolicitud @default(nueva)
  notas       String? // notas internas del equipo Khipu
  /// Hash de la IP (con APP_SECRET) solo para limitar envíos repetidos; nunca la IP en claro.
  ipHash      String          @map("ip_hash")
  /// Colegio creado a partir de esta solicitud.
  tenantId    String?         @map("tenant_id") @db.Uuid
  atendidaPor String?         @map("atendida_por") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([estado, createdAt])
  @@index([ipHash, createdAt])
  @@map("solicitudes_demo")
}

// ─── Khipu Pro completo (2026-10-31): CNEB, documentos, reuniones (specs/30–33) ───

/// Capacidad del CNEB dentro de una competencia (specs/30). Las competencias siguen siendo por curso.
model Capacidad {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  competenciaId String  @map("competencia_id") @db.Uuid
  nombre        String
  descripcion   String?
  orden         Int     @default(0)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  desempenos  Desempeno[]

  @@index([tenantId, competenciaId])
  @@map("capacidades")
}

/// Desempeño esperado del CNEB para un nivel y grado (specs/30). Pertenece a una competencia y,
/// opcionalmente, a una de sus capacidades. Las evaluaciones se vinculan a desempeños (EvaluacionDesempeno).
model Desempeno {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  competenciaId String  @map("competencia_id") @db.Uuid
  capacidadId   String? @map("capacidad_id") @db.Uuid
  nivel         Nivel
  /// Grado dentro del nivel (1–6 primaria, 1–5 secundaria; edad en inicial: 3, 4, 5).
  grado         Int
  descripcion   String
  /// Código opcional del colegio o de la norma («MAT-3P-01»).
  codigo        String?
  orden         Int     @default(0)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competencia  Competencia           @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  capacidad    Capacidad?            @relation(fields: [capacidadId], references: [id], onDelete: SetNull)
  evaluaciones EvaluacionDesempeno[]
  criterios    CriterioEvaluacion[]
  nuditoTemas  NuditoTemaColegio[]

  @@index([tenantId, competenciaId, nivel, grado])
  @@index([capacidadId])
  @@map("desempenos")
}

/// Qué desempeños mide una evaluación (M:N, specs/30).
model EvaluacionDesempeno {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  evaluacionId String @map("evaluacion_id") @db.Uuid
  desempenoId  String @map("desempeno_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluacion Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  desempeno  Desempeno  @relation(fields: [desempenoId], references: [id], onDelete: Cascade)

  @@unique([evaluacionId, desempenoId])
  @@index([tenantId])
  @@index([desempenoId])
  @@map("evaluacion_desempenos")
}

/// Carpeta de la biblioteca de documentos (specs/31). `parentId` null = carpeta raíz.
model CarpetaDocumento {
  // @@W4
  archivadoAt DateTime? @map("archivado_at") @db.Timestamptz
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  nombre       String
  /// Vacío = sin restricción propia; si tiene roles, solo esos roles (y dirección) ven la carpeta y su contenido.
  visibleRoles Rol[]    @default([]) @map("visible_roles")
  salonId      String?  @map("salon_id") @db.Uuid
  orden        Int      @default(0)
  creadoPorId  String   @map("creado_por") @db.Uuid
  ambito       AmbitoDocumento @default(biblioteca)
  eliminadoAt  DateTime? @map("eliminado_at") @db.Timestamptz
  eliminadoPorId String? @map("eliminado_por") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     CarpetaDocumento?  @relation("SubcarpetasDocumento", fields: [parentId], references: [id], onDelete: Cascade)
  hijas      CarpetaDocumento[] @relation("SubcarpetasDocumento")
  creadoPor  Membership         @relation(fields: [creadoPorId], references: [id], onDelete: NoAction)
  salon      Salon?             @relation("CarpetaSalonDocumento", fields: [salonId], references: [id], onDelete: SetNull)
  documentos Documento[]
  compartidos CompartidoDocumento[]
  destacados DestacadoDocumento[]
  accesos AccesoDocumento[]

  @@index([tenantId, parentId])
  @@index([tenantId, archivadoAt])
  @@map("carpetas_documento")
}

/// Documento de la biblioteca del colegio (specs/31). Su archivo es un `Archivo` con `documentoId`.
model Documento {
  // @@W4
  categoria CategoriaBiblioteca @default(otro)
  oficial Boolean @default(false)
  archivadoAt DateTime? @map("archivado_at") @db.Timestamptz
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// null = en la raíz de la biblioteca.
  carpetaId      String?  @map("carpeta_id") @db.Uuid
  titulo         String
  descripcion    String?
  /// Roles que lo ven (dirección siempre). Vacío = solo dirección (borrador o documento interno).
  visibleRoles   Rol[]    @default([]) @map("visible_roles")
  /// Si tiene valor, solo lo ven el personal y las familias/alumnos de ese salón (además del filtro por rol).
  salonId        String?  @map("salon_id") @db.Uuid
  publicadoPorId String   @map("publicado_por") @db.Uuid
  ambito         AmbitoDocumento @default(biblioteca)
  eliminadoAt    DateTime? @map("eliminado_at") @db.Timestamptz
  eliminadoPorId String? @map("eliminado_por") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carpeta      CarpetaDocumento? @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  salon        Salon?            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  publicadoPor Membership        @relation(fields: [publicadoPorId], references: [id], onDelete: NoAction)
  archivos     Archivo[]
  compartidos  CompartidoDocumento[]
  destacados   DestacadoDocumento[]
  accesos      AccesoDocumento[]
  // @@W1

  // @@W2

  // @@W3
  solicitudesPlantilla SolicitudDocumental[]

  @@index([tenantId, carpetaId])
  @@index([tenantId, salonId])
  @@index([tenantId, categoria])
  @@index([tenantId, archivadoAt])
  @@map("documentos")
}

/// Entrada explícita de acceso. Exactamente un recurso y un destinatario (persona o grupo).
model CompartidoDocumento {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  carpetaId String? @map("carpeta_id") @db.Uuid
  documentoId String? @map("documento_id") @db.Uuid
  membershipId String? @map("membership_id") @db.Uuid
  rol Rol?
  salonId String? @map("salon_id") @db.Uuid
  nivel NivelCompartidoDocumento @default(lector)
  creadoPorId String @map("creado_por") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carpeta CarpetaDocumento? @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  documento Documento? @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  membership Membership? @relation("DestinatarioDocumento", fields: [membershipId], references: [id], onDelete: Cascade)
  creadoPor Membership @relation("CreadorCompartidoDocumento", fields: [creadoPorId], references: [id], onDelete: NoAction)
  salon Salon? @relation(fields: [salonId], references: [id], onDelete: Cascade)
  @@index([tenantId, membershipId])
  @@index([tenantId, rol, salonId])
  @@map("compartidos_documento")
}

model DestacadoDocumento {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  carpetaId String? @map("carpeta_id") @db.Uuid
  documentoId String? @map("documento_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  carpeta CarpetaDocumento? @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  documento Documento? @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  @@index([tenantId, membershipId])
  @@map("destacados_documento")
}

model AccesoDocumento {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  carpetaId String? @map("carpeta_id") @db.Uuid
  documentoId String? @map("documento_id") @db.Uuid
  ultimoAt DateTime @default(now()) @map("ultimo_at") @db.Timestamptz
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  carpeta CarpetaDocumento? @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  documento Documento? @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  @@index([tenantId, membershipId, ultimoAt])
  @@map("accesos_documento")
}

/// Para quién es una reunión (specs/32).
enum AlcanceReunion {
  colegio // todo el colegio (o los roles que se inviten)
  salon // las familias y docentes de un salón
  individual // una o pocas personas (p. ej. apoderado de un alumno)
}

enum EstadoReunion {
  por_confirmar // solicitud de una familia (o propuesta) aún sin confirmar por el docente (specs/40)
  programada // confirmada
  realizada
  cancelada
}

/// Tipo de reunión (specs/40): define quién la convoca y a quién invita (`src/lib/reuniones.ts`).
enum TipoReunion {
  docente_apoderado
  tutoria
  coordinacion
  direccion
  administrativa
  institucional
}

enum ModalidadReunion {
  presencial
  virtual
  mixta
}

enum RolInvitadoReunion {
  organizador
  requerido
  opcional
}

enum TipoCambioReunion {
  creada
  reprogramada
  cancelada
  participantes
  respuesta
  realizada
  acta
}

enum EstadoAcuerdo {
  pendiente
  cumplido
}

enum TipoBloqueoAgenda {
  bloqueo // el propio personal reserva un tiempo (motivo privado)
  ausencia // dirección o administrativo registran la ausencia de alguien del personal
}

enum RespuestaReunion {
  pendiente
  asistire // «Aceptada»
  no_asistire // «Rechazada»
  propone_otra // propone otra hora (propuesta_inicio/fin)
}

/// Reunión convocada por el colegio, con confirmación de asistencia y acta (specs/32).
model Reunion {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  titulo            String
  descripcion       String?
  inicio            DateTime         @db.Timestamptz
  fin               DateTime         @db.Timestamptz
  /// Lugar físico («Aula 3.° B»), enlace de videollamada, o ambos.
  lugar             String?
  enlace            String?
  alcance           AlcanceReunion
  /// Obligatorio cuando alcance = salon; opcional en individual (salón del alumno).
  salonId           String?          @map("salon_id") @db.Uuid
  convocadaPorId    String           @map("convocada_por") @db.Uuid
  /// Quien organiza y gestiona (docente que recibe una solicitud de familia; si no, quien convoca).
  organizadorId     String           @map("organizador_id") @db.Uuid
  tipo              TipoReunion      @default(institucional)
  motivo            String?
  modalidad         ModalidadReunion @default(presencial)
  observaciones     String?
  reprogramadaAt    DateTime?        @map("reprogramada_at") @db.Timestamptz
  canceladaPorId    String?          @map("cancelada_por") @db.Uuid
  canceladaAt       DateTime?        @map("cancelada_at") @db.Timestamptz
  motivoCancelacion String?          @map("motivo_cancelacion")
  estado            EstadoReunion    @default(programada)
  /// Acta en texto (Markdown simple). Las familias la ven solo desde `actaPublicadaAt`.
  acta              String?
  actaPublicadaAt   DateTime?        @map("acta_publicada_at") @db.Timestamptz
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salon        Salon?            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  convocadaPor Membership        @relation("ReunionConvocante", fields: [convocadaPorId], references: [id], onDelete: NoAction)
  organizador  Membership        @relation("ReunionOrganizador", fields: [organizadorId], references: [id], onDelete: NoAction)
  invitados    ReunionInvitado[]
  cambios      ReunionCambio[]
  acuerdos     ReunionAcuerdo[]
  reservas     ReservaAgenda[]
  archivos     Archivo[]

  @@index([tenantId, inicio])
  @@index([tenantId, salonId])
  @@map("reuniones")
}

/// Invitación a una reunión: una fila por persona (y por alumno, si el apoderado viene por un hijo concreto).
/// Único (reunión, membresía, alumno) con NULLS NOT DISTINCT (ver migración).
model ReunionInvitado {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  reunionId       String             @map("reunion_id") @db.Uuid
  membershipId    String             @map("membership_id") @db.Uuid
  /// Alumno por el que se cita al apoderado (null para personal o invitaciones generales).
  alumnoId        String?            @map("alumno_id") @db.Uuid
  respuesta       RespuestaReunion   @default(pendiente)
  respondidaAt    DateTime?          @map("respondida_at") @db.Timestamptz
  /// Motivo opcional al responder «no asistiré».
  comentario      String?
  /// Asistencia real, marcada al cerrar la reunión (null = sin marcar).
  asistio         Boolean?
  rol             RolInvitadoReunion @default(requerido)
  invitadoAt      DateTime           @default(now()) @map("invitado_at") @db.Timestamptz
  /// Hora propuesta cuando `respuesta = propone_otra`.
  propuestaInicio DateTime?          @map("propuesta_inicio") @db.Timestamptz
  propuestaFin    DateTime?          @map("propuesta_fin") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reunion    Reunion    @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  alumno     Alumno?    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@unique([reunionId, membershipId, alumnoId])
  @@index([tenantId, membershipId])
  @@map("reunion_invitados")
}

/// Historial inmutable de una reunión (specs/40): creación, reprogramación, cancelación, respuestas, acta…
model ReunionCambio {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  reunionId String            @map("reunion_id") @db.Uuid
  tipo      TipoCambioReunion
  antes     Json?
  despues   Json?
  actorId   String?           @map("actor_id") @db.Uuid
  motivo    String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reunion Reunion     @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  actor   Membership? @relation("ReunionCambioActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, reunionId])
  @@map("reunion_cambios")
}

/// Acuerdo del acta con responsable, fecha de compromiso y seguimiento (specs/40).
model ReunionAcuerdo {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  reunionId       String        @map("reunion_id") @db.Uuid
  texto           String
  responsableId   String?       @map("responsable_id") @db.Uuid
  fechaCompromiso DateTime?     @map("fecha_compromiso") @db.Date
  estado          EstadoAcuerdo @default(pendiente)
  cumplidoAt      DateTime?     @map("cumplido_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reunion     Reunion     @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  responsable Membership? @relation("AcuerdoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([tenantId, reunionId])
  @@index([tenantId, responsableId, estado])
  @@map("reunion_acuerdos")
}

/// Tiempo reservado en la agenda de una persona del personal (specs/40). Sin solapes entre reservas activas de la misma
/// persona: restricción de exclusión GiST `reservas_agenda_sin_solape` (solo en la migración, como otros índices parciales).
model ReservaAgenda {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  reunionId    String?  @map("reunion_id") @db.Uuid
  inicio       DateTime @db.Timestamptz
  fin          DateTime @db.Timestamptz
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  reunion    Reunion?   @relation(fields: [reunionId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId, inicio])
  @@index([reunionId])
  @@map("reservas_agenda")
}

/// Bloqueo propio (motivo privado) o ausencia registrada por dirección/administrativo (specs/40).
model BloqueoAgenda {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  membershipId    String            @map("membership_id") @db.Uuid
  inicio          DateTime          @db.Timestamptz
  fin             DateTime          @db.Timestamptz
  tipo            TipoBloqueoAgenda @default(bloqueo)
  /// Privado: solo lo ven la persona y quien lo registró.
  motivo          String?
  registradoPorId String            @map("registrado_por") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership @relation("BloqueoDe", fields: [membershipId], references: [id], onDelete: Cascade)
  registradoPor Membership @relation("BloqueoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: NoAction)

  @@index([tenantId, membershipId, inicio])
  @@map("bloqueos_agenda")
}

/// Horario de atención a familias de una persona del personal (specs/40): día 1 = lunes … 7 = domingo.
model HorarioAtencion {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  dia          Int
  horaDesde    String @map("hora_desde")
  horaHasta    String @map("hora_hasta")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@map("horarios_atencion")
}

// ─── Nudito+ (2026-10-31): tutor IA por alumno, pagado por la familia (specs/28–29) ───

enum ModoNudito {
  alumno // el alumno usa su propia cuenta
  hijo // «modo hijo»: el alumno usa Nudito+ dentro de la cuenta del apoderado
}

enum EstadoLicenciaNudito {
  activa
  vencida
  cancelada
}

enum OrigenLicenciaNudito {
  pago
  cortesia
  prueba
}

enum MetodoPagoNudito {
  yape
  transferencia
  otro
}

enum EstadoPagoNudito {
  pendiente // reportado por la familia, falta verificar
  verificado // el equipo Khipu confirmó el abono
  rechazado
}

enum TipoAlertaNudito {
  seguridad // filtro de seguridad, riesgo o tema delicado
  animo // señales de desánimo o malestar
  dificultad // dificultad persistente en un tema
  uso // uso excesivo o tope mensual alcanzado
}

/// Licencia de Nudito+ de un alumno (specs/28). Prepago por periodo; se guarda el historial (varias filas por alumno).
/// Vigente = estado activa y hoy entre `desde` y `hasta`. Solo para colegios con plan `pro`.
/// La registra el equipo Khipu desde el panel de plataforma (cliente `db` global con tenantId explícito).
model LicenciaNudito {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  alumnoId        String               @map("alumno_id") @db.Uuid
  estado          EstadoLicenciaNudito @default(activa)
  origen          OrigenLicenciaNudito @default(pago)
  desde           DateTime             @db.Date
  /// Último día incluido.
  hasta           DateTime             @db.Date
  /// Perfil del super administrador que la registró (sin FK, como PagoRegistro).
  registradaPorId String               @map("registrada_por") @db.Uuid
  notas           String?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno Alumno       @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  pagos  PagoNudito[]

  @@index([alumnoId, estado, hasta])
  @@index([tenantId, estado])
  @@index([estado, hasta])
  @@map("licencias_nudito")
}

/// Pago de Nudito+ hecho por la familia (Yape u otro), verificado a mano por el equipo Khipu (specs/28).
/// Puede existir antes de la licencia (pendiente de verificar); al activarla se enlaza `licenciaId`.
model PagoNudito {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  alumnoId        String           @map("alumno_id") @db.Uuid
  licenciaId      String?          @map("licencia_id") @db.Uuid
  /// Apoderado que pagó o reportó el pago.
  apoderadoId     String?          @map("apoderado_id") @db.Uuid
  monto           Decimal          @db.Decimal(10, 2)
  moneda          String           @default("PEN")
  /// Meses comprados con este pago.
  meses           Int              @default(1)
  metodo          MetodoPagoNudito @default(yape)
  /// Número de operación de Yape o de la transferencia.
  referencia      String?
  fechaPago       DateTime         @map("fecha_pago") @db.Date
  estado          EstadoPagoNudito @default(pendiente)
  /// Perfil del super administrador que lo registró o verificó (sin FK). null mientras solo lo reportó la familia.
  registradoPorId String?          @map("registrado_por") @db.Uuid
  verificadoAt    DateTime?        @map("verificado_at") @db.Timestamptz
  notas           String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno    Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  licencia  LicenciaNudito? @relation(fields: [licenciaId], references: [id], onDelete: SetNull)
  apoderado Membership?     @relation(fields: [apoderadoId], references: [id], onDelete: SetNull)

  @@index([tenantId, alumnoId])
  @@index([estado, fechaPago])
  @@map("pagos_nudito")
}

/// Consentimiento del apoderado para que su hijo use el tutor IA (Ley 29733, specs/28). Versionado y revocable.
model ConsentimientoIa {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  apoderadoId          String    @map("apoderado_id") @db.Uuid
  alumnoId             String    @map("alumno_id") @db.Uuid
  versionTexto         String    @map("version_texto")
  aceptadoAt           DateTime  @default(now()) @map("aceptado_at") @db.Timestamptz
  ip                   String?
  revocadoAt           DateTime? @map("revocado_at") @db.Timestamptz
  /// Asentimiento del propio alumno (14+ años), además del consentimiento del apoderado (specs/44). Opcional.
  asentimientoAlumnoAt DateTime? @map("asentimiento_alumno_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apoderado Membership @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)
  alumno    Alumno     @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@index([tenantId, alumnoId])
  @@index([apoderadoId])
  @@map("consentimientos_ia")
}

/// Uso y costo de Nudito+ por alumno y mes (topes en ConfigPlataforma «nudito_plus:limites», specs/29).
model UsoNudito {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  alumnoId         String   @map("alumno_id") @db.Uuid
  /// Mes calendario en hora de Lima, «AAAA-MM».
  mes              String
  mensajes         Int      @default(0)
  tokensEntrada    Int      @default(0) @map("tokens_entrada")
  tokensSalida     Int      @default(0) @map("tokens_salida")
  costoEstimadoUsd Decimal  @default(0) @map("costo_estimado_usd") @db.Decimal(10, 4)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@unique([alumnoId, mes])
  @@index([tenantId, mes])
  @@map("usos_nudito")
}

/// Alerta para el apoderado sobre el uso de Nudito+ por su hijo (sin mostrar la conversación, specs/29).
model AlertaNudito {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  alumnoId       String           @map("alumno_id") @db.Uuid
  tipo           TipoAlertaNudito
  /// Texto para la familia (resumen, nunca la cita textual del alumno).
  detalle        String
  conversacionId String?          @map("conversacion_id") @db.Uuid
  creadaAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  vistaAt        DateTime?        @map("vista_at") @db.Timestamptz

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno       Alumno              @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  conversacion NuditoConversacion? @relation(fields: [conversacionId], references: [id], onDelete: SetNull)

  @@index([tenantId, alumnoId, creadaAt])
  @@map("alertas_nudito")
}

/// Resumen periódico para el apoderado: temas trabajados y avances (specs/29).
model ResumenNudito {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  alumnoId String   @map("alumno_id") @db.Uuid
  desde    DateTime @db.Date
  hasta    DateTime @db.Date
  texto    String
  /// Lista de temas: [{ "area": "Matemática", "tema": "Fracciones", "mensajes": 12 }].
  temas    Json     @default("[]")
  creadoAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@index([tenantId, alumnoId, hasta])
  @@map("resumenes_nudito")
}

/// Sitio del que Nudito+ puede recomendar materiales (lista blanca global del equipo Khipu, specs/29).
model SitioPermitido {
  id          String   @id @default(uuid()) @db.Uuid
  /// Dominio sin esquema ni «www.», en minúsculas («perueduca.pe»). Incluye sus subdominios.
  dominio     String   @unique
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  /// Perfil del super administrador que lo agregó (sin FK).
  creadoPorId String   @map("creado_por") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sitios_permitidos")
}

// ─── Nudito, tutor educativo de Khipu Pro (2026-11-14, specs/41–44) ───
// El catálogo GLOBAL de temas, el banco de Ciencia y las lecturas viven en código (src/lib/nudito/); aquí solo lo
// propio de cada colegio y la actividad por alumno. Nudito nunca escribe notas, registro auxiliar, NSP ni libretas.

enum TipoEjercicioNudito {
  opcion_multiple
  numerico
  fraccion
  texto_corto
  lectura
  escritura_rubrica
  relacionar
  verdadero_falso
}

enum EstadoSesionNudito {
  activa
  finalizada
  abandonada
}

enum FaseSesionNudito {
  bienvenida
  curso
  tema
  repaso
  practica
  comprobacion
  resultados
}

enum ResultadoIntentoNudito {
  correcto
  parcial
  incorrecto
  incierto // no se pudo evaluar con confianza (p. ej. rúbrica con IA dudosa): no cuenta para el dominio
}

enum EstadoDominioNudito {
  no_iniciado
  en_progreso
  en_comprobacion
  dominado
  reforzar
}

enum TipoEventoDominioNudito {
  dificultad_sube
  dificultad_baja
  estado
  desbloqueo_tema
  bloqueo_tema
}

enum OperacionIaNudito {
  explicar
  pista
  retroalimentar_abierta
  interpretar_imagen
  preguntar
  moderar
  validar_tema
}

/// Configuración institucional de Nudito (1:1 con el colegio). Sin fila = Nudito apagado en el colegio (specs/44).
model NuditoConfigColegio {
  /// `id` propio (como todo modelo del colegio: la exportación pagina por `id`); 1:1 por `tenantId` único.
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @unique @map("tenant_id") @db.Uuid
  /// Interruptor institucional (lo maneja dirección).
  activo              Boolean   @default(false)
  /// El equipo Khipu puede bloquearlo (incidente, impago…): manda sobre `activo`.
  bloqueadoPlataforma Boolean   @default(false) @map("bloqueado_plataforma")
  /// Claves de área habilitadas (`AREAS_NUDITO`).
  areas               String[]  @default(["matematica", "comunicacion", "ciencia-tecnologia"])
  niveles             Nivel[]   @default([primaria, secundaria])
  gradoMinimoPrimaria Int       @default(1) @map("grado_minimo_primaria")
  permitirModoHijo    Boolean   @default(true) @map("permitir_modo_hijo")
  permitirFotos       Boolean   @default(false) @map("permitir_fotos")
  minutosPorDia       Int?      @map("minutos_por_dia")
  sesionesPorDia      Int       @default(6) @map("sesiones_por_dia")
  /// Tope de costo estimado de IA del colegio por mes (USD). null = sin tope institucional.
  topeCostoUsdMes     Decimal?  @map("tope_costo_usd_mes") @db.Decimal(10, 2)
  /// Días que se guardan intentos, mensajes y fotos (los dominios y sus eventos se conservan).
  retencionDias       Int       @default(180) @map("retencion_dias")
  /// HH:mm, ventana de uso opcional.
  horaDesde           String?   @map("hora_desde")
  horaHasta           String?   @map("hora_hasta")
  /// Cambios sobre `POLITICA_DOMINIO_POR_DEFECTO` (validados con `esquemaPoliticaDominio`).
  politicaDominio     Json?     @map("politica_dominio")
  actualizadoPorId    String?   @map("actualizado_por") @db.Uuid
  activadoAt          DateTime? @map("activado_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("nudito_config_colegio")
}

/// Tema propio del colegio (los globales están en código). Clave pública: «col:<id>».
model NuditoTemaColegio {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  area            String
  competenciaCneb Int                   @map("competencia_cneb")
  capacidad       String?
  desempenoId     String?               @map("desempeno_id") @db.Uuid
  nivel           Nivel
  grado           Int
  nombre          String
  subtema         String?
  descripcion     String?
  palabrasClave   String[]              @default([]) @map("palabras_clave")
  /// Claves de temas (globales o «col:<id>»).
  prerrequisitos  String[]              @default([])
  dificultadMin   Int                   @default(1) @map("dificultad_min")
  dificultadMax   Int                   @default(5) @map("dificultad_max")
  tipos           TipoEjercicioNudito[]
  /// `FuenteTema` (generador del registro o ítems de banco revisados).
  fuente          Json
  /// [{ titulo, url }] solo de dominios en SitioPermitido.
  recursos        Json                  @default("[]")
  activo          Boolean               @default(true)
  creadoPorId     String                @map("creado_por") @db.Uuid
  revisadoPorId   String?               @map("revisado_por") @db.Uuid
  revisadoAt      DateTime?             @map("revisado_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  desempeno Desempeno? @relation(fields: [desempenoId], references: [id], onDelete: SetNull)

  @@index([tenantId, area, nivel, grado])
  @@index([desempenoId])
  @@map("nudito_temas_colegio")
}

/// Sesión de tutoría: bienvenida → curso → tema → repaso → práctica → resultados (specs/41). Se reanuda si sigue activa.
model NuditoSesion {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  alumnoId          String             @map("alumno_id") @db.Uuid
  /// Quién la usa: la cuenta del alumno o la del apoderado en modo hijo.
  membershipId      String             @map("membership_id") @db.Uuid
  modo              ModoNudito         @default(alumno)
  /// Conversación de «preguntar» y explicaciones (reutiliza NuditoConversacion).
  conversacionId    String?            @map("conversacion_id") @db.Uuid
  cursoId           String?            @map("curso_id") @db.Uuid
  area              String?
  temaClave         String?            @map("tema_clave")
  /// Grado del tema trabajado (puede ser anterior, o posterior si se desbloqueó); el grado oficial no cambia.
  gradoTema         Int?               @map("grado_tema")
  fase              FaseSesionNudito   @default(bienvenida)
  estado            EstadoSesionNudito @default(activa)
  dificultad        Int                @default(1)
  semilla           Int
  /// Ejercicios previstos.
  meta              Int                @default(5)
  /// { aciertos, parciales, total, pistas, segundos } al finalizar.
  resumen           Json?
  iniciadaAt        DateTime           @default(now()) @map("iniciada_at") @db.Timestamptz
  ultimaActividadAt DateTime           @default(now()) @map("ultima_actividad_at") @db.Timestamptz
  finalizadaAt      DateTime?          @map("finalizada_at") @db.Timestamptz

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno       Alumno              @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  membership   Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  conversacion NuditoConversacion? @relation(fields: [conversacionId], references: [id], onDelete: SetNull)
  curso        Curso?              @relation(fields: [cursoId], references: [id], onDelete: SetNull)
  ejercicios   NuditoEjercicio[]
  mensajes     NuditoMensaje[]
  archivos     Archivo[]
  consumos     NuditoConsumoIa[]

  @@index([tenantId, alumnoId, estado, ultimaActividadAt])
  @@index([tenantId, cursoId, iniciadaAt])
  @@map("nudito_sesiones")
}

/// Ejercicio presentado. `enunciado` es el EjercicioPublico; `solucion` NUNCA sale del servidor.
model NuditoEjercicio {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  sesionId       String              @map("sesion_id") @db.Uuid
  alumnoId       String              @map("alumno_id") @db.Uuid
  temaClave      String              @map("tema_clave")
  tipo           TipoEjercicioNudito
  dificultad     Int
  /// generadorId@versión | bancoId:itemId | coleccionId:lecturaId
  fuenteId       String              @map("fuente_id")
  semilla        Int
  enunciado      Json
  /// Solución, pistas y explicación (EjercicioConSolucion sin la parte pública). Solo servidor.
  solucion       Json
  esComprobacion Boolean             @default(false) @map("es_comprobacion")
  orden          Int
  pistasUsadas   Int                 @default(0) @map("pistas_usadas")
  presentadoAt   DateTime            @default(now()) @map("presentado_at") @db.Timestamptz
  cerradoAt      DateTime?           @map("cerrado_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sesion   NuditoSesion    @relation(fields: [sesionId], references: [id], onDelete: Cascade)
  alumno   Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  intentos NuditoIntento[]

  @@unique([sesionId, orden])
  @@index([tenantId, alumnoId, temaClave, presentadoAt])
  @@map("nudito_ejercicios")
}

/// Respuesta del alumno a un ejercicio y su evaluación. (ejercicio, número) único: evita el doble envío.
model NuditoIntento {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  ejercicioId    String                 @map("ejercicio_id") @db.Uuid
  alumnoId       String                 @map("alumno_id") @db.Uuid
  numero         Int
  respuesta      Json
  resultado      ResultadoIntentoNudito
  /// 0..1
  puntaje        Decimal                @db.Decimal(4, 3)
  /// Código del error típico detectado («suma_denominadores»…).
  errorDetectado String?                @map("error_detectado")
  retro          String
  /// codigo | banco | rubrica_ia | rubrica_simulada
  evaluadoPor    String                 @map("evaluado_por")
  pistasUsadas   Int                    @map("pistas_usadas")
  tiempoMs       Int?                   @map("tiempo_ms")
  fotoArchivoId  String?                @map("foto_archivo_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ejercicio NuditoEjercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  alumno    Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  foto      Archivo?        @relation(fields: [fotoArchivoId], references: [id], onDelete: SetNull)

  @@unique([ejercicioId, numero])
  @@index([tenantId, alumnoId, createdAt])
  @@index([fotoArchivoId])
  @@map("nudito_intentos")
}

/// Dominio del alumno por tema/habilidad (política configurable, specs/43). No cambia el grado oficial.
model NuditoDominio {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  alumnoId              String              @map("alumno_id") @db.Uuid
  temaClave             String              @map("tema_clave")
  area                  String
  gradoTema             Int                 @map("grado_tema")
  estado                EstadoDominioNudito @default(no_iniciado)
  dificultad            Int                 @default(1)
  intentos              Int                 @default(0)
  aciertos              Int                 @default(0)
  aciertosSinPista      Int                 @default(0) @map("aciertos_sin_pista")
  sesionesDistintas     Int                 @default(0) @map("sesiones_distintas")
  racha                 Int                 @default(0)
  /// Ventana de los últimos N `EvidenciaPractica`.
  evidencia             Json                @default("[]")
  /// Motivo legible del último cambio.
  motivo                String?
  politicaVersion       String              @map("politica_version")
  /// Evento que autorizó trabajar este tema por encima del grado oficial.
  autorizadoPorEventoId String?             @map("autorizado_por_evento_id") @db.Uuid
  dominadoAt            DateTime?           @map("dominado_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno              Alumno               @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  autorizadoPorEvento NuditoDominioEvento? @relation(fields: [autorizadoPorEventoId], references: [id], onDelete: SetNull)

  @@unique([alumnoId, temaClave])
  @@index([tenantId, alumnoId, area])
  @@index([autorizadoPorEventoId])
  @@map("nudito_dominios")
}

/// Historial de cambios de dominio: por qué se subió/bajó la dificultad, se dio dominio o se desbloqueó un tema.
model NuditoDominioEvento {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  alumnoId     String                  @map("alumno_id") @db.Uuid
  temaClave    String                  @map("tema_clave")
  tipo         TipoEventoDominioNudito
  deEstado     EstadoDominioNudito?    @map("de_estado")
  aEstado      EstadoDominioNudito?    @map("a_estado")
  deDificultad Int?                    @map("de_dificultad")
  aDificultad  Int?                    @map("a_dificultad")
  motivo       String
  evidencia    Json
  /// Copia de la política aplicada (versión y umbrales).
  politica     Json
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno      Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  autorizados NuditoDominio[]

  @@index([tenantId, alumnoId, temaClave, createdAt])
  @@map("nudito_dominio_eventos")
}

/// Consumo por llamada al proveedor de IA (real o simulado). UsoNudito sigue siendo el total mensual por alumno.
model NuditoConsumoIa {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  alumnoId         String            @map("alumno_id") @db.Uuid
  sesionId         String?           @map("sesion_id") @db.Uuid
  operacion        OperacionIaNudito
  proveedor        String
  modelo           String?
  tokensEntrada    Int               @default(0) @map("tokens_entrada")
  tokensSalida     Int               @default(0) @map("tokens_salida")
  costoEstimadoUsd Decimal           @default(0) @map("costo_estimado_usd") @db.Decimal(10, 6)
  latenciaMs       Int?              @map("latencia_ms")
  cache            Boolean           @default(false)
  simulado         Boolean           @default(true)
  ok               Boolean           @default(true)
  error            String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno Alumno        @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  sesion NuditoSesion? @relation(fields: [sesionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([alumnoId, createdAt])
  @@index([sesionId])
  @@map("nudito_consumos_ia")
}

// ─── Horario semanal por salón (2026-10-30, specs/34) ───

enum TipoHoraHorario {
  clase
  recreo
}

/// Plantilla de horario (specs/34): la dirección o secretaría define entrada, duración de la hora de clase, recreos y
/// salida; Khipu calcula las horas del día (`HorarioPeriodo`) y luego se pueden retocar. Cada salón usa una.
model PlantillaHorario {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  nombre          String
  /// HH:mm. Desde la entrada, la llegada es tardanza (specs/05).
  horaEntrada     String   @map("hora_entrada")
  horaSalida      String   @map("hora_salida")
  /// Minutos de cada hora de clase.
  duracionClase   Int      @map("duracion_clase")
  /// HH:mm. Sin ingreso a esta hora = falta del día (control de ingreso automático).
  horaLimiteFalta String   @map("hora_limite_falta")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodos HorarioPeriodo[]
  salones  Salon[]

  @@unique([tenantId, nombre])
  @@map("plantillas_horario")
}

/// «Horas del día» de una plantilla: los periodos (timbres) que comparten todos los salones que la usan.
model HorarioPeriodo {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  plantillaId String          @map("plantilla_id") @db.Uuid
  /// «1.ª hora», «Recreo»…
  nombre      String
  /// HH:mm (hora del colegio).
  horaInicio  String          @map("hora_inicio")
  horaFin     String          @map("hora_fin")
  tipo        TipoHoraHorario @default(clase)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plantilla PlantillaHorario @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  bloques   BloqueHorario[]

  @@index([tenantId, plantillaId])
  @@map("horario_periodos")
}

/// Un casillero del horario de un salón: día (1 = lunes … 5 = viernes) × periodo. Es un curso del salón
/// (el profesor sale del curso) o un bloque sin curso con título («Tutoría», «Formación») y profesor opcional.
model BloqueHorario {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  salonId    String   @map("salon_id") @db.Uuid
  dia        Int
  periodoId  String   @map("periodo_id") @db.Uuid
  cursoId    String?  @map("curso_id") @db.Uuid
  /// Solo en bloques sin curso.
  titulo     String?
  /// Solo en bloques sin curso: quién está a cargo (p. ej. la tutora en «Tutoría»).
  profesorId String?  @map("profesor_id") @db.Uuid
  aula       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salon    Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  periodo  HorarioPeriodo @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  curso    Curso?         @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  profesor Membership?    @relation(fields: [profesorId], references: [id], onDelete: SetNull)

  @@unique([salonId, dia, periodoId])
  @@index([tenantId, salonId])
  @@index([tenantId, cursoId])
  @@index([tenantId, profesorId])
  @@index([periodoId])
  @@map("bloques_horario")
}

// ───────────── NSP, incidencias, libretas emitidas y resumen académico (specs/37) ─────────────

/// Incidencia de un alumno durante la jornada (accidente, malestar…), con retiro anticipado opcional. La descripción es
/// sensible: solo la ven dirección, el tutor del salón y quien la registró. Los cursos afectados reciben una falta a clase.
model Incidencia {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  alumnoId        String         @map("alumno_id") @db.Uuid
  fecha           DateTime       @db.Date
  /// HH:mm de la incidencia (hora del colegio).
  hora            String
  tipo            TipoIncidencia
  descripcion     String
  retiro          Boolean        @default(false)
  horaRetiro      String?        @map("hora_retiro")
  registradoPorId String         @map("registrado_por") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno        Alumno            @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  registradoPor Membership        @relation(fields: [registradoPorId], references: [id], onDelete: NoAction)
  cursos        IncidenciaCurso[]
  asistencias   Asistencia[]

  @@index([tenantId, fecha])
  @@index([alumnoId, fecha])
  @@map("incidencias")
}

/// Permiso de asistencia (specs/04): el colegio autoriza que el alumno no asista (todo el día) o falte unas horas entre
/// dos fechas. Un permiso vigente evita la falta automática del control de ingreso (día completo) y el NSP de las
/// faltas que cubre (specs/37). No se borra: se anula con motivo.
model PermisoAsistencia {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  alumnoId        String    @map("alumno_id") @db.Uuid
  desde           DateTime  @db.Date
  hasta           DateTime  @db.Date
  /// true = todo el día; false = solo entre horaDesde y horaHasta (HH:mm) de cada día del rango.
  todoElDia       Boolean   @default(true) @map("todo_el_dia")
  horaDesde       String?   @map("hora_desde")
  horaHasta       String?   @map("hora_hasta")
  motivo          String
  registradoPorId String    @map("registrado_por") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  anuladoAt       DateTime? @map("anulado_at") @db.Timestamptz
  anuladoPorId    String?   @map("anulado_por") @db.Uuid
  motivoAnulacion String?   @map("motivo_anulacion")

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno        Alumno      @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  registradoPor Membership  @relation("PermisoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: NoAction)
  anuladoPor    Membership? @relation("PermisoAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: NoAction)

  @@index([tenantId, desde])
  @@index([alumnoId, desde, hasta])
  @@map("permisos_asistencia")
}

/// Clase afectada por una incidencia (el alumno no estuvo).
model IncidenciaCurso {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  incidenciaId String @map("incidencia_id") @db.Uuid
  cursoId      String @map("curso_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidencia Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
  curso      Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([incidenciaId, cursoId])
  @@index([tenantId])
  @@index([cursoId])
  @@map("incidencia_cursos")
}

/// Versión emitida (congelada) de la libreta de un alumno en un periodo. La versión 1 se crea al publicar la libreta; las
/// siguientes, solo al aprobar una rectificación. Ninguna se modifica después.
model LibretaEmitida {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  alumnoId        String   @map("alumno_id") @db.Uuid
  periodoId       String   @map("periodo_id") @db.Uuid
  version         Int
  datos           Json
  emitidaPorId    String   @map("emitida_por") @db.Uuid
  emitidaAt       DateTime @default(now()) @map("emitida_at") @db.Timestamptz
  rectificacionId String?  @unique @map("rectificacion_id") @db.Uuid

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Restrict + trigger sin DELETE (migración 20261112090300): solo se borra con el colegio completo.
  alumno        Alumno                @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  periodo       Periodo               @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  emitidaPor    Membership            @relation(fields: [emitidaPorId], references: [id], onDelete: NoAction)
  rectificacion RectificacionLibreta? @relation(fields: [rectificacionId], references: [id], onDelete: SetNull)

  @@unique([alumnoId, periodoId, version])
  @@index([tenantId, periodoId])
  @@map("libretas_emitidas")
}

/// Solicitud formal para corregir una calificación de una libreta ya emitida. Dirección la aprueba o rechaza.
model RectificacionLibreta {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  alumnoId             String               @map("alumno_id") @db.Uuid
  periodoId            String               @map("periodo_id") @db.Uuid
  competenciaId        String               @map("competencia_id") @db.Uuid
  /// Texto de la calificación emitida («B», «12»; null = sin calificación).
  valorAnterior        String?              @map("valor_anterior")
  valorLiteral         CalificacionLiteral? @map("valor_literal")
  valorNumerico        Decimal?             @map("valor_numerico") @db.Decimal(4, 2)
  conclusion           String?
  motivo               String
  evidencia            String?
  estado               EstadoRectificacion  @default(pendiente)
  solicitadaPorId      String               @map("solicitada_por") @db.Uuid
  solicitadaAt         DateTime             @default(now()) @map("solicitada_at") @db.Timestamptz
  resueltaPorId        String?              @map("resuelta_por") @db.Uuid
  resueltaAt           DateTime?            @map("resuelta_at") @db.Timestamptz
  comentarioResolucion String?              @map("comentario_resolucion")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno        Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  periodo       Periodo         @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  competencia   Competencia     @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  solicitadaPor Membership      @relation("RectificacionSolicitada", fields: [solicitadaPorId], references: [id], onDelete: NoAction)
  resueltaPor   Membership?     @relation("RectificacionResuelta", fields: [resueltaPorId], references: [id], onDelete: SetNull)
  libreta       LibretaEmitida?

  @@index([tenantId, estado])
  @@index([alumnoId, periodoId])
  @@map("rectificaciones_libreta")
}

/// Resumen académico diario (specs/37): una fila por colegio y día marca que ya se encoló, para enviarlo una sola vez
/// aunque el cron corra varias veces o haya dos workers. Cubre lo publicado en [desde, hasta).
model ResumenAcademicoDia {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  fecha     DateTime @db.Date
  desde     DateTime @db.Timestamptz
  hasta     DateTime @db.Timestamptz
  alumnos   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fecha])
  @@map("resumenes_academicos")
}

// ───────────── Notificaciones académicas por eventos (specs/38) ─────────────

enum TipoEventoAcademico {
  resultados_publicados
  nota_corregida
}

/// Qué originó una notificación de la bandeja interna (specs/38).
enum TipoNotificacion {
  calificacion // resultado publicado o corregido (evento académico)
  tarea
  evaluacion_programada
  mensaje
  comunicado
  justificacion // al profesor: justificación aprobada con actividades de su curso
  incidencia // al profesor: el alumno no estará en su clase
  reunion // invitación, reprogramación, cancelación, respuesta o solicitud de reunión (specs/40)
  solicitud // solicitud documental al personal (specs/46)
}

enum EstadoEventoAcademico {
  pendiente
  procesando
  procesado
  error
}

/// Outbox transaccional: se crea en la MISMA transacción que publica (o corrige) resultados. Un worker asíncrono lo
/// convierte en notificaciones internas y push; si el push falla, el evento y la bandeja quedan. Publicar no depende
/// del servicio de notificaciones. Una publicación = un evento (índice único parcial por grupo).
model EventoAcademico {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  tipo           TipoEventoAcademico
  /// `evaluaciones.grupo_id` (todas las columnas de la actividad).
  grupoId        String                @map("grupo_id") @db.Uuid
  /// Solo en correcciones: el alumno afectado.
  alumnoId       String?               @map("alumno_id") @db.Uuid
  creadoPorId    String?               @map("creado_por") @db.Uuid
  estado         EstadoEventoAcademico @default(pendiente)
  intentos       Int                   @default(0)
  error          String?
  reservadoAt    DateTime?             @map("reservado_at") @db.Timestamptz
  procesadoAt    DateTime?             @map("procesado_at") @db.Timestamptz
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  /// Conteos al procesar: alumnos afectados, notificaciones internas creadas y push encolados.
  alumnos        Int                   @default(0)
  notificaciones Int                   @default(0)
  push           Int                   @default(0)

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notificacionesCreadas Notificacion[]

  @@index([estado, createdAt])
  @@index([tenantId, createdAt])
  @@map("eventos_academicos")
}

/// Bandeja interna de Khipu (specs/38): una por evento, apoderado y alumno. Siempre visible en Khipu aunque el push no
/// llegue. El texto no lleva notas (puede verse en la pantalla bloqueada).
model Notificacion {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  /// Alumno del que trata (si lo hay): la familia solo la ve mientras siga viendo a ese alumno.
  alumnoId     String?          @map("alumno_id") @db.Uuid
  /// Evento académico que la originó (solo `calificacion`).
  eventoId     String?          @map("evento_id") @db.Uuid
  tipo         TipoNotificacion
  /// Idempotencia de los demás productores («tarea:<id>», «comunicado:<id>»…): única por colegio y membresía.
  clave        String?
  titulo       String
  cuerpo       String
  /// Ruta dentro del colegio («/notas?alumno=…#ev-…»).
  url          String
  leidaAt      DateTime?        @map("leida_at") @db.Timestamptz
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  alumno     Alumno?          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  evento     EventoAcademico? @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  avisos     Aviso[]

  @@unique([eventoId, membershipId, alumnoId])
  @@unique([tenantId, membershipId, clave])
  @@index([membershipId, leidaAt, createdAt])
  @@index([tenantId])
  @@map("notificaciones")
}

// ===== W1 =====
enum CategoriaArchivo {
  documento
  material_clase
  material_tarea
  entrega
  solicitud
  borrador
  comunicado
  soporte
  justificacion
  reunion
  foto
  logo
  nudito
  exportacion
  otro
}

enum EstadoSubida {
  pendiente
  confirmada
  fallida
  expirada
  cancelada
}

model AlmacenamientoColegio {
  tenantId              String   @id @map("tenant_id") @db.Uuid
  limiteBytes           BigInt?  @map("limite_bytes")
  usadoBytes            BigInt   @default(0) @map("usado_bytes")
  reservadoBytes        BigInt   @default(0) @map("reservado_bytes")
  reservaCriticaPct     Int      @default(5) @map("reserva_critica_pct")
  maxBytesDocumento     Int      @default(26214400) @map("max_bytes_documento")
  maxBytesEntrega       Int      @default(10485760) @map("max_bytes_entrega")
  maxArchivosEntrega    Int      @default(3) @map("max_archivos_entrega")
  cuotaBorradorBytes    BigInt   @default(2147483648) @map("cuota_borrador_bytes")
  purgaAutomaticaActiva Boolean  @default(false) @map("purga_automatica_activa")
  umbralNotificado      Int      @default(0) @map("umbral_notificado")
  actualizadoAt         DateTime @updatedAt @map("actualizado_at") @db.Timestamptz
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("almacenamiento_colegio")
}

model UsoAlmacenamientoCategoria {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  categoria CategoriaArchivo
  bytes     BigInt           @default(0)
  archivos  Int              @default(0)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoria])
  @@map("uso_almacenamiento_categoria")
}

model SubidaArchivo {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  membershipId    String           @map("membership_id") @db.Uuid
  categoria       CategoriaArchivo
  critica         Boolean          @default(false)
  nombre          String
  mimeDeclarado   String           @map("mime_declarado")
  bytesDeclarados Int              @map("bytes_declarados")
  proveedor       ProveedorArchivo
  publicId        String           @map("public_id")
  estado          EstadoSubida     @default(pendiente)
  reservaBytes    BigInt           @map("reserva_bytes")
  contexto        Json?
  archivoId       String?          @map("archivo_id") @db.Uuid
  error           String?
  expiraAt        DateTime         @map("expira_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  confirmadaAt    DateTime?        @map("confirmada_at") @db.Timestamptz
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership      Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  archivo         Archivo?         @relation(fields: [archivoId], references: [id], onDelete: SetNull)

  @@index([tenantId, estado, expiraAt])
  @@map("subidas_archivo")
}

model MetricaAlmacenamientoDia {
  id                      String           @id @default(uuid()) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  dia                     DateTime         @db.Date
  categoria               CategoriaArchivo
  subidas                 Int              @default(0)
  bytesSubidos            BigInt           @default(0) @map("bytes_subidos")
  borrados                Int              @default(0)
  bytesBorrados           BigInt           @default(0) @map("bytes_borrados")
  descargas               Int              @default(0)
  bytesDescargaEstimados  BigInt           @default(0) @map("bytes_descarga_estimados")
  rechazosCuota           Int              @default(0) @map("rechazos_cuota")
  subidasFallidas         Int              @default(0) @map("subidas_fallidas")
  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dia, categoria])
  @@map("metricas_almacenamiento_dia")
}

// ===== W2 =====
enum EstadoMaterial {
  borrador
  publicado
  archivado
}

model MaterialClase {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  titulo String
  descripcion String?
  unidadTema String? @map("unidad_tema")
  estado EstadoMaterial @default(borrador)
  versionActual Int @default(1) @map("version_actual")
  creadoPorId String @map("creado_por") @db.Uuid
  carpetaId String? @map("carpeta_id") @db.Uuid
  publicadoAt DateTime? @map("publicado_at") @db.Timestamptz
  archivadoAt DateTime? @map("archivado_at") @db.Timestamptz
  eliminadoAt DateTime? @map("eliminado_at") @db.Timestamptz
  eliminadoPorId String? @map("eliminado_por") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creadoPor Membership @relation("AutorMaterial", fields: [creadoPorId], references: [id], onDelete: Restrict)
  carpeta CarpetaMaterial? @relation(fields: [carpetaId], references: [id], onDelete: SetNull)
  secciones MaterialSeccion[]
  versiones MaterialVersion[]
  tareas TareaMaterial[]

  @@index([tenantId, creadoPorId])
  @@index([tenantId, estado])
