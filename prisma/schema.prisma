// Esquema de Khipu Escolar. Documentación por módulo en specs/.
// Toda tabla de negocio lleva tenantId. El acceso pasa SIEMPRE por src/lib/server (db.forTenant).
// RLS está activado en todas las tablas y cerrado para anon/authenticated (ver migración rls_cerrado).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Plan {
  basico
  fase2
  promax
}

enum Rol {
  direccion
  profesor
  apoderado
  alumno
  porteria
  administrativo // personal no docente (secretaría, auxiliares, psicología…)
}

enum TipoIdentificacion {
  dni
  ce // carné de extranjería
  pasaporte
}

enum EstadoMembresia {
  activa
  invitada
  inactiva
}

enum EstadoTenant {
  activo
  piloto
  suspendido
}

enum ModoAvisos {
  todos
  solo_excepciones
}

enum EscalaCalificacion {
  literal
  vigesimal
}

enum Nivel {
  inicial
  primaria
  secundaria
  academia
}

enum EstadoAlumno {
  activo
  retirado
}

enum EstadoAsistencia {
  llego
  tarde
  falta
  problema
}

enum OrigenAsistencia {
  lista
  porteria
}

enum TipoAviso {
  asistencia
  resumen_llegadas
  mensaje
  comunicado
  invitacion
  justificacion
  tarea
  alerta_direccion
  libreta
  soporte
}

enum CanalAviso {
  correo
  push
  whatsapp
  sms
}

enum EstadoAviso {
  pendiente
  enviando // reservado por un worker; evita envíos duplicados
  enviado
  entregado
  abierto
  rebotado
  queja
  error
  omitido
}

/// Para el trato en la interfaz («Tutora» / «Tutor»). Opcional.
enum Genero {
  femenino
  masculino
  no_especifica
}

enum EstadoJustificacion {
  pendiente
  aceptada
  rechazada
}

enum ProveedorArchivo {
  local
  cloudinary
  s3
}

enum TipoPeriodo {
  bimestre
  trimestre
  semestre
}

enum CalificacionLiteral {
  AD
  A
  B
  C
}

enum TipoEvento {
  evento
  reunion
  examen
  feriado
  actividad
}

enum TipoDocumento {
  reglamento
  horario
  calendario
  otro
}

enum AutorNudito {
  usuario
  nudito
}

// ───────────────────────────── Núcleo ─────────────────────────────

model Tenant {
  id                            String             @id @default(uuid()) @db.Uuid
  slug                          String             @unique
  nombre                        String
  ciudad                        String?
  eslogan                       String?
  plan                          Plan               @default(basico)
  emailDomains                  String[]           @default([]) @map("email_domains")
  logoArchivoId                 String?            @map("logo_archivo_id") @db.Uuid
  horaEnvioAvisos               String             @default("09:00") @map("hora_envio_avisos") // HH:mm, resumen de llegadas
  horaLimiteTardanza            String             @default("08:00") @map("hora_limite_tardanza") // HH:mm, desde esta hora la llegada es «tarde»
  zonaHoraria                   String             @default("America/Lima") @map("zona_horaria")
  modoAvisos                    ModoAvisos         @default(todos) @map("modo_avisos")
  escalaCalificacion            EscalaCalificacion @default(literal) @map("escala_calificacion")
  /// Plazo del reglamento para justificar una falta, en días hábiles (lunes a viernes sin feriados nacionales del Perú) desde el día de la falta.
  plazoJustificacionDiasHabiles Int                @default(15) @map("plazo_justificacion_dias_habiles")
  /// Canales de pago habilitados por el colegio (specs/06). Requieren credenciales del proveedor en el servidor.
  whatsappActivo                Boolean            @default(false) @map("whatsapp_activo")
  smsActivo                     Boolean            @default(false) @map("sms_activo")
  estado                        EstadoTenant       @default(activo)
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  memberships           Membership[]
  salones               Salon[]
  cursos                Curso[]
  alumnos               Alumno[]
  apoderadosAlumnos     ApoderadoAlumno[]
  consentimientos       Consentimiento[]
  auditoria             Auditoria[]
  asistencias           Asistencia[]
  avisos                Aviso[]
  justificacionTokens   JustificacionToken[]
  justificaciones       Justificacion[]
  archivos              Archivo[]
  conversaciones        Conversacion[]
  mensajes              Mensaje[]
  comunicados           Comunicado[]
  preferenciasAviso     PreferenciaAviso[]
  carnetsQr             CarnetQr[]
  periodos              Periodo[]
  competencias          Competencia[]
  evaluaciones          Evaluacion[]
  notas                 Nota[]
  calificacionesPeriodo CalificacionPeriodo[]
  tareas                Tarea[]
  eventosAgenda         EventoAgenda[]
  documentosColegio     DocumentoColegio[]
  nuditoConversaciones  NuditoConversacion[]
  nuditoMensajes        NuditoMensaje[]
  exportaciones         ExportacionColegio[]
  accesosSoporte        AccesoSoporte[]
  cierresCurso          CierreCurso[]
  modulosAjustados      TenantModulo[]
  contactos             ContactoColegio[]
  suscripcion           Suscripcion?
  pagos                 PagoRegistro[]
  feriados              FeriadoExtra[]
  ticketsSoporte        TicketSoporte[]
  mensajesSoporte       MensajeSoporte[]

  @@map("tenants")
}

/// Usuario global. id = auth.users.id de Supabase.
model Profile {
  id                  String              @id @db.Uuid
  email               String              @unique
  nombres             String
  apellidos           String              @default("")
  telefono            String?
  genero              Genero?
  tipoDocumento       TipoIdentificacion? @map("tipo_documento")
  numeroDocumento     String?             @map("numero_documento")
  fechaNacimiento     DateTime?           @map("fecha_nacimiento") @db.Date
  direccion           String?
  /// true mientras use la contraseña inicial (su DNI): se le obliga a cambiarla al entrar.
  debeCambiarPassword Boolean             @default(false) @map("debe_cambiar_password")
  ultimoIngresoAt     DateTime?           @map("ultimo_ingreso_at") @db.Timestamptz
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  memberships       Membership[]
  pushSuscripciones PushSuscripcion[]

  adminPlataforma AdminPlataforma?

  @@index([numeroDocumento])
  @@map("profiles")
}

/// Rol de un usuario dentro de un colegio. Un usuario puede tener varias.
model Membership {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  rol       Rol
  estado    EstadoMembresia @default(activa)
  cargo     String? // «Director(a) general», «Secretaria», «Docente de Matemática»…
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  salonesTutor             Salon[]              @relation("TutorSalon")
  cursosDictados           Curso[]              @relation("ProfesorCurso")
  hijos                    ApoderadoAlumno[]
  consentimientos          Consentimiento[]
  asistenciasRegistradas   Asistencia[]         @relation("RegistradoPor")
  avisos                   Aviso[]
  justificacionTokens      JustificacionToken[]
  justificaciones          Justificacion[]      @relation("JustificacionApoderado")
  justificacionesRevisadas Justificacion[]      @relation("JustificacionRevisor")
  conversacionesProfesor   Conversacion[]       @relation("ConversacionProfesor")
  conversacionesApoderado  Conversacion[]       @relation("ConversacionApoderado")
  mensajes                 Mensaje[]
  comunicados              Comunicado[]
  preferenciaAviso         PreferenciaAviso?
  notasRegistradas         Nota[]
  tareasCreadas            Tarea[]
  eventosCreados           EventoAgenda[]
  nuditoConversaciones     NuditoConversacion[]
  ticketsSoporte           TicketSoporte[]      @relation("TicketsCreados")
  alumnoVinculado          Alumno?              @relation("CuentaAlumno")
  cierresCurso             CierreCurso[]

  @@unique([tenantId, userId, rol])
  @@index([userId])
  @@map("memberships")
}

model Salon {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  nombre      String // "3.° B"
  nivel       Nivel
  grado       Int?
  seccion     String?
  anio        Int
  tutorId     String?   @map("tutor_id") @db.Uuid
  /// Salón de un año cerrado: deja de listarse para pasar lista, pero conserva su historial.
  archivadoAt DateTime? @map("archivado_at") @db.Timestamptz

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor       Membership?    @relation("TutorSalon", fields: [tutorId], references: [id], onDelete: SetNull)
  cursos      Curso[]
  alumnos     Alumno[]
  comunicados Comunicado[]
  eventos     EventoAgenda[]

  @@index([tenantId])
  @@map("salones")
}

model Curso {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  salonId    String  @map("salon_id") @db.Uuid
  nombre     String // "Matemática"
  profesorId String? @map("profesor_id") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  profesor     Membership?   @relation("ProfesorCurso", fields: [profesorId], references: [id], onDelete: SetNull)
  asistencias  Asistencia[]
  competencias Competencia[]
  evaluaciones Evaluacion[]
  tareas       Tarea[]
  cierres      CierreCurso[]

  @@index([tenantId])
  @@index([profesorId])
  @@map("cursos")
}

/// El menor NO necesita cuenta en el plan Básico.
model Alumno {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  salonId       String       @map("salon_id") @db.Uuid
  nombres       String
  apellidos     String
  codigo        String?
  estado        EstadoAlumno @default(activo)
  fotoArchivoId String?      @map("foto_archivo_id") @db.Uuid
  /// Membresía con rol `alumno` (cuenta propia del estudiante), si tiene.
  cuentaId      String?      @unique @map("cuenta_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuenta                Membership?           @relation("CuentaAlumno", fields: [cuentaId], references: [id], onDelete: SetNull)
  salon                 Salon                 @relation(fields: [salonId], references: [id], onDelete: NoAction)
  apoderados            ApoderadoAlumno[]
  asistencias           Asistencia[]
  conversaciones        Conversacion[]
  carnets               CarnetQr[]
  notas                 Nota[]
  calificacionesPeriodo CalificacionPeriodo[]
  nuditoConversaciones  NuditoConversacion[]

  @@index([tenantId, salonId])
  @@map("alumnos")
}

model ApoderadoAlumno {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  apoderadoId      String  @map("apoderado_id") @db.Uuid
  alumnoId         String  @map("alumno_id") @db.Uuid
  parentesco       String  @default("apoderado") // madre, padre, tutor legal…
  recibeAvisos     Boolean @default(true) @map("recibe_avisos")
  consentimientoId String? @map("consentimiento_id") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apoderado      Membership      @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)
  alumno         Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  consentimiento Consentimiento? @relation(fields: [consentimientoId], references: [id], onDelete: SetNull)

  @@unique([apoderadoId, alumnoId])
  @@index([tenantId])
  @@map("apoderados_alumnos")
}

/// Consentimiento versionado del apoderado (Ley 29733). Requerido antes de enviar avisos.
model Consentimiento {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  apoderadoId  String    @map("apoderado_id") @db.Uuid
  versionTexto String    @map("version_texto")
  aceptadoAt   DateTime  @default(now()) @map("aceptado_at") @db.Timestamptz
  ip           String?
  revocadoAt   DateTime? @map("revocado_at") @db.Timestamptz

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apoderado Membership        @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)
  vinculos  ApoderadoAlumno[]

  @@index([tenantId, apoderadoId])
  @@map("consentimientos")
}

/// Quién vio o cambió qué.
model Auditoria {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid // profile id
  accion    String // ver | crear | editar | borrar | exportar | enviar
  entidad   String
  entidadId String?  @map("entidad_id")
  detalle   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("auditoria")
}

/// Límite de intentos de login (servidor).
model LoginIntento {
  id        BigInt   @id @default(autoincrement())
  email     String
  ip        String
  exito     Boolean
  /// Solo en ingresos exitosos (sin FK: el registro sobrevive al borrado del perfil).
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("login_intentos")
}

// ───────────────────────── Plan Básico ─────────────────────────

model Asistencia {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  alumnoId        String           @map("alumno_id") @db.Uuid
  cursoId         String?          @map("curso_id") @db.Uuid // null = asistencia del día (portería / tutor)
  ambito          String // = cursoId, o "dia" para la asistencia del día; hace única la fila
  fecha           DateTime         @db.Date
  hora            String // HH:mm, hora local del colegio
  estado          EstadoAsistencia
  nota            String?
  origen          OrigenAsistencia @default(lista)
  registradoPorId String           @map("registrado_por") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno          Alumno               @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  curso           Curso?               @relation(fields: [cursoId], references: [id], onDelete: SetNull)
  registradoPor   Membership           @relation("RegistradoPor", fields: [registradoPorId], references: [id], onDelete: NoAction)
  avisos          Aviso[]
  tokens          JustificacionToken[]
  justificaciones Justificacion[]

  @@unique([alumnoId, fecha, ambito])
  @@index([tenantId, fecha])
  @@map("asistencias")
}

/// Cola y registro de avisos (correo o push). El worker respeta EMAIL_DAILY_LIMIT.
model Aviso {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  tipo              TipoAviso
  canal             CanalAviso
  asistenciaId      String?     @map("asistencia_id") @db.Uuid
  apoderadoId       String?     @map("apoderado_id") @db.Uuid
  destinatario      String // correo o endpoint push
  plantilla         String
  asunto            String
  payload           Json        @default("{}")
  referenciaId      String?     @map("referencia_id") // conversación, tarea, etc. (para agrupar y limitar avisos)
  providerMessageId String?     @unique @map("provider_message_id")
  estado            EstadoAviso @default(pendiente)
  intentos          Int         @default(0)
  error             String?
  programadoPara    DateTime    @default(now()) @map("programado_para") @db.Timestamptz
  enviadoAt         DateTime?   @map("enviado_at") @db.Timestamptz
  entregadoAt       DateTime?   @map("entregado_at") @db.Timestamptz
  abiertoAt         DateTime?   @map("abierto_at") @db.Timestamptz
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asistencia Asistencia? @relation(fields: [asistenciaId], references: [id], onDelete: SetNull)
  apoderado  Membership? @relation(fields: [apoderadoId], references: [id], onDelete: SetNull)

  @@index([estado, programadoPara])
  @@index([tenantId, createdAt])
  @@map("avisos")
}

/// Enlace «Justificar falta» de un solo uso. Se guarda solo el hash.
model JustificacionToken {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  asistenciaId String    @map("asistencia_id") @db.Uuid
  apoderadoId  String    @map("apoderado_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiraAt     DateTime  @map("expira_at") @db.Timestamptz
  usadoAt      DateTime? @map("usado_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asistencia Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)
  apoderado  Membership @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)

  @@map("justificacion_tokens")
}

model Justificacion {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  asistenciaId       String              @map("asistencia_id") @db.Uuid
  apoderadoId        String              @map("apoderado_id") @db.Uuid
  motivo             String
  adjuntoArchivoId   String?             @map("adjunto_archivo_id") @db.Uuid
  estado             EstadoJustificacion @default(pendiente)
  comentarioRevision String?             @map("comentario_revision")
  revisadoPorId      String?             @map("revisado_por") @db.Uuid
  revisadoAt         DateTime?           @map("revisado_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asistencia  Asistencia  @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)
  apoderado   Membership  @relation("JustificacionApoderado", fields: [apoderadoId], references: [id], onDelete: Cascade)
  revisadoPor Membership? @relation("JustificacionRevisor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  adjunto     Archivo?    @relation(fields: [adjuntoArchivoId], references: [id], onDelete: SetNull)

  @@index([tenantId, estado])
  @@map("justificaciones")
}

/// Archivos subidos (Cloudinary hoy, S3 después). Los de menores son privados.
model Archivo {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  proveedor        ProveedorArchivo
  publicId         String           @map("public_id")
  url              String? // solo para archivos públicos (p. ej. logo)
  mimeType         String           @map("mime_type")
  bytes            Int
  privado          Boolean          @default(true)
  subidoPorId      String?          @map("subido_por") @db.Uuid
  /// Adjunto de un comunicado o de una tarea (specs/09, specs/12).
  comunicadoId     String?          @map("comunicado_id") @db.Uuid
  tareaId          String?          @map("tarea_id") @db.Uuid
  /// Captura o archivo adjunto a un mensaje de la mesa de ayuda (specs/23).
  mensajeSoporteId String?          @map("mensaje_soporte_id") @db.Uuid
  nombre           String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  justificaciones Justificacion[]
  comunicado      Comunicado?          @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  tarea           Tarea?               @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  exportaciones   ExportacionColegio[]
  mensajeSoporte  MensajeSoporte?      @relation(fields: [mensajeSoporteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([comunicadoId])
  @@index([tareaId])
  @@map("archivos")
}

/// Chat familia ↔ profesor sin exponer teléfonos.
model Conversacion {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  alumnoId    String   @map("alumno_id") @db.Uuid
  profesorId  String   @map("profesor_id") @db.Uuid
  apoderadoId String   @map("apoderado_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno    Alumno     @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  profesor  Membership @relation("ConversacionProfesor", fields: [profesorId], references: [id], onDelete: Cascade)
  apoderado Membership @relation("ConversacionApoderado", fields: [apoderadoId], references: [id], onDelete: Cascade)
  mensajes  Mensaje[]

  @@unique([alumnoId, profesorId, apoderadoId])
  @@index([tenantId])
  @@map("conversaciones")
}

model Mensaje {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversacionId String    @map("conversacion_id") @db.Uuid
  autorId        String    @map("autor_id") @db.Uuid
  cuerpo         String
  leidoAt        DateTime? @map("leido_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autor        Membership   @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([conversacionId, createdAt])
  @@map("mensajes")
}

model Comunicado {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  autorId     String   @map("autor_id") @db.Uuid
  salonId     String?  @map("salon_id") @db.Uuid // null = todo el colegio
  titulo      String
  cuerpo      String
  publicadoAt DateTime @default(now()) @map("publicado_at") @db.Timestamptz

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  autor    Membership @relation(fields: [autorId], references: [id], onDelete: Cascade)
  salon    Salon?     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  adjuntos Archivo[]

  @@index([tenantId, publicadoAt])
  @@map("comunicados")
}

/// Suscripción Web Push de un dispositivo (global al usuario).
model PushSuscripcion {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_suscripciones")
}

model PreferenciaAviso {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  apoderadoId String  @unique @map("apoderado_id") @db.Uuid
  correo      Boolean @default(true)
  push        Boolean @default(true)
  /// Canales de pago (specs/06): solo se usan si el colegio los activó y hay teléfono.
  whatsapp    Boolean @default(false)
  sms         Boolean @default(false)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apoderado Membership @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)

  @@map("preferencias_aviso")
}

/// Carnet con QR para portería. El QR lleva un token firmado; aquí solo el hash.
model CarnetQr {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  alumnoId   String    @map("alumno_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revocadoAt DateTime? @map("revocado_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@index([tenantId, alumnoId])
  @@map("carnets_qr")
}

// ───────────────────────── Fase 2 (Familia) ─────────────────────────

model Periodo {
  id                 String      @id @default(uuid()) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  anio               Int
  tipo               TipoPeriodo
  numero             Int
  nombre             String // "I Bimestre"
  inicio             DateTime    @db.Date
  fin                DateTime    @db.Date
  cerrado            Boolean     @default(false)
  /// Cuándo se avisó a las familias que la libreta del periodo está lista.
  libretaPublicadaAt DateTime?   @map("libreta_publicada_at") @db.Timestamptz

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluaciones          Evaluacion[]
  calificacionesPeriodo CalificacionPeriodo[]
  cierresCurso          CierreCurso[]

  @@unique([tenantId, anio, tipo, numero])
  @@map("periodos")
}

/// Competencia del CNEB asociada a un curso.
model Competencia {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  cursoId     String  @map("curso_id") @db.Uuid
  nombre      String
  descripcion String?
  orden       Int     @default(0)

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curso                 Curso                 @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  evaluaciones          Evaluacion[]
  calificacionesPeriodo CalificacionPeriodo[]

  @@index([tenantId, cursoId])
  @@map("competencias")
}

model Evaluacion {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  cursoId       String   @map("curso_id") @db.Uuid
  periodoId     String   @map("periodo_id") @db.Uuid
  competenciaId String?  @map("competencia_id") @db.Uuid
  titulo        String
  fecha         DateTime @db.Date
  peso          Decimal  @default(1) @db.Decimal(5, 2)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curso       Curso        @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  periodo     Periodo      @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  competencia Competencia? @relation(fields: [competenciaId], references: [id], onDelete: SetNull)
  notas       Nota[]

  @@index([tenantId, cursoId, periodoId])
  @@map("evaluaciones")
}

/// Nota de una evaluación. Literal (AD/A/B/C) o vigesimal (0–20) según la escala del colegio.
model Nota {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  evaluacionId    String               @map("evaluacion_id") @db.Uuid
  alumnoId        String               @map("alumno_id") @db.Uuid
  valorLiteral    CalificacionLiteral? @map("valor_literal")
  valorNumerico   Decimal?             @map("valor_numerico") @db.Decimal(4, 2)
  comentario      String?
  registradoPorId String               @map("registrado_por") @db.Uuid
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluacion    Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  alumno        Alumno     @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  registradoPor Membership @relation(fields: [registradoPorId], references: [id], onDelete: NoAction)

  @@unique([evaluacionId, alumnoId])
  @@map("notas")
}

/// Calificación de una competencia en un periodo (lo que va en la libreta), con conclusión descriptiva.
model CalificacionPeriodo {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  alumnoId      String               @map("alumno_id") @db.Uuid
  competenciaId String               @map("competencia_id") @db.Uuid
  periodoId     String               @map("periodo_id") @db.Uuid
  valorLiteral  CalificacionLiteral? @map("valor_literal")
  valorNumerico Decimal?             @map("valor_numerico") @db.Decimal(4, 2)
  conclusion    String?
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno      Alumno      @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  periodo     Periodo     @relation(fields: [periodoId], references: [id], onDelete: Cascade)

  @@unique([alumnoId, competenciaId, periodoId])
  @@map("calificaciones_periodo")
}

model Tarea {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  cursoId      String   @map("curso_id") @db.Uuid
  titulo       String
  descripcion  String?
  fechaEntrega DateTime @map("fecha_entrega") @db.Timestamptz
  creadoPorId  String   @map("creado_por") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curso     Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  creadoPor Membership @relation(fields: [creadoPorId], references: [id], onDelete: NoAction)
  adjuntos  Archivo[]

  @@index([tenantId, fechaEntrega])
  @@map("tareas")
}

model EventoAgenda {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  salonId     String?    @map("salon_id") @db.Uuid // null = todo el colegio
  titulo      String
  descripcion String?
  tipo        TipoEvento @default(evento)
  inicio      DateTime   @db.Timestamptz
  fin         DateTime?  @db.Timestamptz
  creadoPorId String     @map("creado_por") @db.Uuid

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salon     Salon?     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  creadoPor Membership @relation(fields: [creadoPorId], references: [id], onDelete: NoAction)

  @@index([tenantId, inicio])
  @@map("eventos_agenda")
}

// ───────────────────────── Pro Max (Nudito) ─────────────────────────

/// Documentos del colegio que Nudito puede citar (reglamento, horario, calendario).
model DocumentoColegio {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tipo      TipoDocumento
  titulo    String
  contenido String
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, tipo])
  @@map("documentos_colegio")
}

model NuditoConversacion {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  alumnoId     String?  @map("alumno_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  alumno     Alumno?         @relation(fields: [alumnoId], references: [id], onDelete: SetNull)
  mensajes   NuditoMensaje[]

  @@index([tenantId, membershipId])
  @@map("nudito_conversaciones")
}

model NuditoMensaje {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  conversacionId String      @map("conversacion_id") @db.Uuid
  autor          AutorNudito
  cuerpo         String
  intencion      String?
  derivado       Boolean     @default(false)
  acciones       Json? // botones de la respuesta (abrir_chat, elegir_hijo, ir)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversacion NuditoConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, createdAt])
  @@map("nudito_mensajes")
}

// ───────────────────────── Plataforma (equipo Khipu) ─────────────────────────

/// Super administrador de la plataforma: crea colegios y ve reportes globales. No pertenece a ningún colegio.
/// Se crea solo por script (pnpm khipu:crear-superadmin), nunca desde la web.
model AdminPlataforma {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins_plataforma")
}

/// Auditoría de acciones de plataforma (crear colegio, cambiar plan, suspender, exportar, borrar).
model AuditoriaPlataforma {
  id        BigInt   @id @default(autoincrement())
  actorId   String   @map("actor_id") @db.Uuid
  accion    String
  tenantId  String?  @map("tenant_id") @db.Uuid // sin FK: debe sobrevivir al borrado del colegio
  detalle   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("auditoria_plataforma")
}

// ─── Pendientes v2 (2026-10-27) ──────────────────────────────────────────────

/// Cierre de notas de un curso en un periodo (además del cierre general del periodo).
model CierreCurso {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  periodoId    String   @map("periodo_id") @db.Uuid
  cursoId      String   @map("curso_id") @db.Uuid
  cerradoPorId String   @map("cerrado_por") @db.Uuid
  cerradoAt    DateTime @default(now()) @map("cerrado_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodo    Periodo    @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  curso      Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  cerradoPor Membership @relation(fields: [cerradoPorId], references: [id], onDelete: NoAction)

  @@unique([periodoId, cursoId])
  @@index([tenantId])
  @@map("cierres_curso")
}

enum EstadoExportacion {
  pendiente
  procesando
  lista
  error
}

/// Exportación del colegio armada en segundo plano por el cron (specs/15).
model ExportacionColegio {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  /// Perfil que la pidió (dirección del colegio o super administrador).
  solicitadoPorId String            @map("solicitado_por") @db.Uuid
  estado          EstadoExportacion @default(pendiente)
  archivoId       String?           @map("archivo_id") @db.Uuid
  error           String?
  intentos        Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  terminadoAt     DateTime?         @map("terminado_at") @db.Timestamptz

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  archivo Archivo? @relation(fields: [archivoId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([estado, createdAt])
  @@map("exportaciones_colegio")
}

/// Acceso temporal del super administrador a un colegio para dar soporte (specs/16). Siempre auditado.
model AccesoSoporte {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  motivo    String
  inicioAt  DateTime  @default(now()) @map("inicio_at") @db.Timestamptz
  expiraAt  DateTime  @map("expira_at") @db.Timestamptz
  cerradoAt DateTime? @map("cerrado_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, inicioAt])
  @@index([adminId, expiraAt])
  @@map("accesos_soporte")
}

// ─── Panel de plataforma v2 (2026-10-28): catálogo de planes, roles, responsables, suscripciones ───

/// Catálogo comercial de cada plan (specs/19). El código del plan sigue siendo el enum `Plan`.
model PlanCatalogo {
  plan                Plan     @id
  nombre              String // «Básico», «Familia», «Pro Max»
  descripcion         String?
  /// Precio por alumno al mes en soles (referencial; el precio real va en la suscripción del colegio).
  precioPorAlumno     Decimal? @map("precio_por_alumno") @db.Decimal(8, 2)
  precioMinimoMensual Decimal? @map("precio_minimo_mensual") @db.Decimal(10, 2)
  maxAlumnos          Int?     @map("max_alumnos")
  orden               Int      @default(0)
  activo              Boolean  @default(true) // si es false no se ofrece a colegios nuevos
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  modulos PlanModulo[]

  @@map("planes_catalogo")
}

/// Módulos que incluye cada plan. `modulo` es una clave de `FEATURES` (src/lib/planes.ts).
model PlanModulo {
  plan   Plan
  modulo String

  catalogo PlanCatalogo @relation(fields: [plan], references: [plan], onDelete: Cascade)

  @@id([plan, modulo])
  @@map("plan_modulos")
}

/// Roles por defecto de todos los colegios: qué módulos ve cada rol. Solo se guardan las celdas
/// cambiadas respecto del comportamiento del código (sin fila = habilitado si el código lo permite).
model RolModulo {
  rol        Rol
  modulo     String
  habilitado Boolean
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([rol, modulo])
  @@map("rol_modulos")
}

/// Ajuste de módulos de un colegio sobre su plan: `habilitado=true` agrega un módulo extra; `false` lo quita.
model TenantModulo {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  modulo     String
  habilitado Boolean
  motivo     String?
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, modulo])
  @@map("tenant_modulos")
}

enum TipoContacto {
  principal
  direccion_academica
  administrativo
  facturacion
  tecnico
  otro
}

/// Responsables y contactos del colegio (puede haber varios; uno es el principal).
/// Si tiene acceso al sistema, `membershipId` apunta a su membresía (normalmente rol dirección).
model ContactoColegio {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  tipo         TipoContacto
  nombres      String
  apellidos    String       @default("")
  cargo        String?
  email        String
  telefono     String?
  principal    Boolean      @default(false)
  membershipId String?      @map("membership_id") @db.Uuid
  notas        String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("contactos_colegio")
}

enum CicloFacturacion {
  mensual
  anual
}

enum EstadoSuscripcion {
  prueba
  activa
  suspendida
  cancelada
}

/// Contrato comercial del colegio (registro manual; no hay pasarela de pagos).
model Suscripcion {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @unique @map("tenant_id") @db.Uuid
  plan               Plan
  ciclo              CicloFacturacion  @default(mensual)
  estado             EstadoSuscripcion @default(prueba)
  moneda             String            @default("PEN")
  /// Monto por ciclo acordado con el colegio.
  montoPorCiclo      Decimal           @map("monto_por_ciclo") @db.Decimal(10, 2)
  alumnosContratados Int?              @map("alumnos_contratados")
  inicio             DateTime          @db.Date
  proximaRenovacion  DateTime          @map("proxima_renovacion") @db.Date
  notas              String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([proximaRenovacion])
  @@map("suscripciones")
}

/// Pago recibido de un colegio (registro manual del equipo Khipu).
model PagoRegistro {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  monto           Decimal  @db.Decimal(10, 2)
  moneda          String   @default("PEN")
  fechaPago       DateTime @map("fecha_pago") @db.Date
  periodoDesde    DateTime @map("periodo_desde") @db.Date
  periodoHasta    DateTime @map("periodo_hasta") @db.Date
  metodo          String // transferencia, yape, plin, depósito, otro
  comprobante     String? // número de boleta/factura
  registradoPorId String   @map("registrado_por") @db.Uuid // perfil del super administrador
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fechaPago])
  @@map("pagos_registro")
}

enum NivelAnuncio {
  info
  novedad
  mantenimiento
  urgente
}

enum AudienciaAnuncio {
  direccion
  personal // dirección, profesores, administrativos, portería
  todos // también familias y alumnos
}

/// Anuncio del equipo Khipu a los colegios (franja en su panel entre `desde` y `hasta`).
model AnuncioPlataforma {
  id          String           @id @default(uuid()) @db.Uuid
  titulo      String
  cuerpo      String
  nivel       NivelAnuncio     @default(info)
  audiencia   AudienciaAnuncio @default(direccion)
  /// Vacío = todos los colegios; si no, solo estos planes.
  planes      Plan[]           @default([])
  desde       DateTime         @db.Timestamptz
  hasta       DateTime         @db.Timestamptz
  creadoPorId String           @map("creado_por") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([desde, hasta])
  @@map("anuncios_plataforma")
}

/// Días no laborables además de los feriados nacionales fijos (src/lib/dias-habiles.ts):
/// feriados regionales, días decretados por el gobierno o días propios de un colegio (`tenantId`).
model FeriadoExtra {
  id        String   @id @default(uuid()) @db.Uuid
  fecha     DateTime @db.Date
  nombre    String
  /// null = todo el país (o la región indicada); con valor = solo ese colegio.
  tenantId  String?  @map("tenant_id") @db.Uuid
  region    String? // p. ej. «Cusco»; null = nacional
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@map("feriados_extra")
}

/// Ajustes globales de la plataforma (clave → valor JSON). P. ej. horario de Nudito, última ejecución de crons.
model ConfigPlataforma {
  clave     String   @id
  valor     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("config_plataforma")
}

// ─── Mesa de ayuda: chat colegio ↔ equipo Khipu (specs/23) ───────────────────

enum CategoriaTicket {
  duda
  problema
  sugerencia
  facturacion
  cuentas_accesos
  otro
}

enum PrioridadTicket {
  baja
  normal
  alta
  urgente
}

enum EstadoTicket {
  abierto // nuevo, sin respuesta de Khipu
  en_progreso // Khipu lo está atendiendo
  esperando_colegio // Khipu respondió y espera al colegio
  resuelto // Khipu lo dio por resuelto (el colegio puede reabrir)
  cerrado // cerrado definitivamente
}

enum AutorSoporte {
  colegio
  khipu
  sistema // cambios de estado y asignación
}

/// Conversación de soporte de un colegio con el equipo Khipu.
model TicketSoporte {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  asunto               String
  categoria            CategoriaTicket @default(duda)
  prioridad            PrioridadTicket @default(normal)
  estado               EstadoTicket    @default(abierto)
  /// Membresía de quien la abrió (dirección o quien tenga el módulo «soporte»).
  creadoPorId          String          @map("creado_por") @db.Uuid
  /// Perfil del super administrador asignado (sin FK: el equipo vive en admins_plataforma).
  asignadoAId          String?         @map("asignado_a") @db.Uuid
  ultimoMensajeAt      DateTime        @default(now()) @map("ultimo_mensaje_at") @db.Timestamptz
  primeraRespuestaAt   DateTime?       @map("primera_respuesta_at") @db.Timestamptz
  resueltoAt           DateTime?       @map("resuelto_at") @db.Timestamptz
  /// Hasta cuándo leyó cada lado (contadores de no leídos).
  leidoColegioHasta    DateTime?       @map("leido_colegio_hasta") @db.Timestamptz
  leidoKhipuHasta      DateTime?       @map("leido_khipu_hasta") @db.Timestamptz
  /// Valoración del colegio (1–5) y comentario opcional.
  valoracion           Int?
  comentarioValoracion String?         @map("comentario_valoracion")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creadoPor Membership       @relation("TicketsCreados", fields: [creadoPorId], references: [id], onDelete: NoAction)
  mensajes  MensajeSoporte[]

  @@index([tenantId, ultimoMensajeAt])
  @@index([estado, ultimoMensajeAt])
  @@index([asignadoAId])
  @@map("tickets_soporte")
}

/// Mensaje de una conversación de soporte. `interno = true`: nota del equipo Khipu que el colegio no ve.
model MensajeSoporte {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  ticketId  String       @map("ticket_id") @db.Uuid
  autor     AutorSoporte
  /// Perfil de quien escribe; null en mensajes del sistema.
  autorId   String?      @map("autor_id") @db.Uuid
  cuerpo    String
  interno   Boolean      @default(false)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket   TicketSoporte @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adjuntos Archivo[]

  @@index([ticketId, createdAt])
  @@map("mensajes_soporte")
}
