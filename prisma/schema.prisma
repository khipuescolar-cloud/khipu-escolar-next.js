// ───────────────────────── Khipu Pro ─────────────────────────

model Periodo {
  id                 String      @id @default(uuid()) @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  anio               Int
  tipo               TipoPeriodo
  numero             Int
  nombre             String // "I Bimestre"
  inicio             DateTime    @db.Date
  fin                DateTime    @db.Date
  cerrado            Boolean     @default(false)
  /// Niveles que trabajan con este periodo (specs/11): cada nivel elige bimestres, trimestres o semestres en el año;
  /// los niveles con el mismo tipo comparten las fechas.
  niveles            Nivel[]     @default([inicial, primaria, secundaria, academia])
  /// Cuándo se avisó a las familias que la libreta del periodo está lista.
  libretaPublicadaAt DateTime?   @map("libreta_publicada_at") @db.Timestamptz

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluaciones          Evaluacion[]
  calificacionesPeriodo CalificacionPeriodo[]
  cierresCurso          CierreCurso[]
  informesProgreso      InformeProgreso[]
  enviosInformeProgreso EnvioInformeProgreso[]
  comentariosTutor      ComentarioTutor[]
  libretasEmitidas      LibretaEmitida[]
  rectificaciones       RectificacionLibreta[]

  @@unique([tenantId, anio, tipo, numero])
  @@map("periodos")
}

/// Competencia del CNEB asociada a un curso.
model Competencia {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  cursoId     String  @map("curso_id") @db.Uuid
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  origen      OrigenCompetencia @default(oficial)
  codigoOficial String? @map("codigo_oficial")
  desactivadaAt DateTime? @map("desactivada_at") @db.Timestamptz
  desactivadaPorId String? @map("desactivada_por_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curso                 Curso                  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  evaluaciones          Evaluacion[]
  calificacionesPeriodo CalificacionPeriodo[]
  capacidades           Capacidad[]
  desempenos            Desempeno[]
  informesProgreso      InformeProgreso[]
  rectificaciones       RectificacionLibreta[]
  tareas                Tarea[]
  desactivadaPor Membership? @relation("CompetenciaDesactivadaPor", fields: [desactivadaPorId], references: [id], onDelete: SetNull)

  @@index([tenantId, cursoId])
  @@map("competencias")
}

model Evaluacion {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  cursoId       String                 @map("curso_id") @db.Uuid
  periodoId     String                 @map("periodo_id") @db.Uuid
  competenciaId String?                @map("competencia_id") @db.Uuid
  titulo        String
  fecha         DateTime               @db.Date
  creadaAt      DateTime               @default(now()) @map("creada_at") @db.Timestamptz
  actualizadaAt DateTime               @default(now()) @updatedAt @map("actualizada_at") @db.Timestamptz
  creadaPorId   String?                @map("creada_por_id") @db.Uuid
  peso          Decimal                @default(1) @db.Decimal(5, 2)
  instrumento   InstrumentoEvaluacion?
  /// Une las columnas de una misma evaluación que mide varias competencias (una fila por competencia).
  grupoId       String                 @default(dbgenerated("gen_random_uuid()")) @map("grupo_id") @db.Uuid
  descripcion   String?
  /// Por defecto `publicada` (datos anteriores, cargas y seeds); `crearEvaluacion` crea las nuevas como `programada`.
  estado        EstadoEvaluacion       @default(publicada)
  publicadaAt   DateTime?              @map("publicada_at") @db.Timestamptz
  /// Evaluación creada desde una tarea calificable (specs/39): nunca genera NSP (specs/37).
  tareaId       String?                @map("tarea_id") @db.Uuid
  claveIdempotencia String?           @unique @map("clave_idempotencia") @db.Uuid

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curso       Curso                 @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  tarea       Tarea?                @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  periodo     Periodo               @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  competencia Competencia?          @relation(fields: [competenciaId], references: [id], onDelete: SetNull)
  creadaPor Membership?             @relation("EvaluacionCreadaPor", fields: [creadaPorId], references: [id], onDelete: SetNull)
  notas       Nota[]
  desempenos  EvaluacionDesempeno[]
  historial   HistorialNota[]
  criterios   CriterioEvaluacion[]

  @@index([tenantId, cursoId, periodoId])
  @@index([grupoId])
  @@index([tareaId])
  @@map("evaluaciones")
}

/// Nota de una evaluación. Literal (AD/A/B/C) o vigesimal (0–20) según la escala del colegio.
model Nota {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  evaluacionId      String               @map("evaluacion_id") @db.Uuid
  alumnoId          String               @map("alumno_id") @db.Uuid
  valorLiteral      CalificacionLiteral? @map("valor_literal")
  valorNumerico     Decimal?             @map("valor_numerico") @db.Decimal(4, 2)
  comentario        String?
  /// Observación solo para el profesor: la familia no la ve (specs/38).
  comentarioPrivado Boolean              @default(false) @map("comentario_privado")
  /// Null = la creó Khipu (NSP por asistencia o consecuencia por vencimiento).
  registradoPorId   String?              @map("registrado_por") @db.Uuid
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  /// NSP (faltó) o «No entregó» (asistió pero no entregó). Sin valor = estado académico, no una calificación (specs/37).
  marca             MarcaNota?
  /// Cuándo Khipu aplicó la consecuencia por vencimiento del plazo (el valor queda en valorLiteral/valorNumerico).
  vencidaAt         DateTime?            @map("vencida_at") @db.Timestamptz
  /// Justificación aprobada que cubre este NSP.
  justificacionId   String?              @map("justificacion_id") @db.Uuid
  recuperacion      EstadoRecuperacion?
  recuperacionPorId String?              @map("recuperacion_por") @db.Uuid
  recuperacionAt    DateTime?            @map("recuperacion_at") @db.Timestamptz
  /// Día en que el alumno rindió la recuperación (la fecha original de la actividad no cambia).
  fechaRecuperacion DateTime?            @map("fecha_recuperacion") @db.Date

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluacion      Evaluacion     @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  alumno          Alumno         @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  registradoPor   Membership?    @relation(fields: [registradoPorId], references: [id], onDelete: NoAction)
  justificacion   Justificacion? @relation(fields: [justificacionId], references: [id], onDelete: SetNull)
  recuperacionPor Membership?    @relation("RecuperacionDecidida", fields: [recuperacionPorId], references: [id], onDelete: SetNull)

  @@unique([evaluacionId, alumnoId])
  // Índices de rendimiento (docs/pruebas-de-estres.md, migración 20261101090000_indices_rendimiento).
  @@index([alumnoId])
  @@index([registradoPorId])
  @@index([tenantId, marca])
  @@map("notas")
}

/// Calificación de una competencia en un periodo (lo que va en la libreta), con conclusión descriptiva.
model CalificacionPeriodo {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  alumnoId      String               @map("alumno_id") @db.Uuid
  competenciaId String               @map("competencia_id") @db.Uuid
  periodoId     String               @map("periodo_id") @db.Uuid
  valorLiteral  CalificacionLiteral? @map("valor_literal")
  valorNumerico Decimal?             @map("valor_numerico") @db.Decimal(4, 2)
  conclusion    String?
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno      Alumno      @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  competencia Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  periodo     Periodo     @relation(fields: [periodoId], references: [id], onDelete: Cascade)

  @@unique([alumnoId, competenciaId, periodoId])
  @@map("calificaciones_periodo")
}

/// Informe de progreso a mitad del periodo (specs/11): por alumno, competencia y periodo, qué logró, qué necesita mejorar
/// y qué se recomienda reforzar. La familia lo ve cuando el profesor lo comparte (`EnvioInformeProgreso`).
model InformeProgreso {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  alumnoId        String   @map("alumno_id") @db.Uuid
  competenciaId   String   @map("competencia_id") @db.Uuid
  periodoId       String   @map("periodo_id") @db.Uuid
  logros          String?
  mejorar         String?
  recomendaciones String?
  registradoPorId String   @map("registrado_por") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno        Alumno      @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  periodo       Periodo     @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  registradoPor Membership  @relation(fields: [registradoPorId], references: [id], onDelete: NoAction)

  @@unique([alumnoId, competenciaId, periodoId])
  @@index([tenantId])
  @@index([periodoId, competenciaId])
  @@map("informes_progreso")
}

/// Cada cambio de una nota (specs/11, specs/37; inmutable: un trigger impide UPDATE): valor anterior y nuevo (texto: «A», «14,5»; null = sin nota), quién y cuándo.
model HistorialNota {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  evaluacionId    String         @map("evaluacion_id") @db.Uuid
  alumnoId        String         @map("alumno_id") @db.Uuid
  valorAnterior   String?        @map("valor_anterior")
  valorNuevo      String?        @map("valor_nuevo")
  /// Null = Khipu (sistema): NSP por asistencia, consecuencia por vencimiento.
  cambiadoPorId   String?        @map("cambiado_por") @db.Uuid
  cambiadoAt      DateTime       @default(now()) @map("cambiado_at") @db.Timestamptz
  tipo            TipoCambioNota @default(registro)
  /// «valor» (la nota) o «recuperacion» (decisión del profesor).
  campo           String         @default("valor")
  motivo          String?
  justificacionId String?        @map("justificacion_id") @db.Uuid
  /// La evaluación ya estaba publicada cuando se hizo el cambio.
  publicada       Boolean        @default(false)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Restrict (migración 20261112090300): una evaluación con historial no se borra.
  evaluacion    Evaluacion     @relation(fields: [evaluacionId], references: [id], onDelete: Restrict)
  alumno        Alumno         @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  cambiadoPor   Membership?    @relation(fields: [cambiadoPorId], references: [id], onDelete: NoAction)
  justificacion Justificacion? @relation(fields: [justificacionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([evaluacionId, cambiadoAt])
  @@map("historial_notas")
}

/// Comentario general del tutor del salón para un alumno en un periodo; va en la libreta (specs/11). Opcional.
model ComentarioTutor {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  alumnoId  String   @map("alumno_id") @db.Uuid
  periodoId String   @map("periodo_id") @db.Uuid
  texto     String
  autorId   String   @map("autor_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno  Alumno     @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  periodo Periodo    @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  autor   Membership @relation(fields: [autorId], references: [id], onDelete: NoAction)

  @@unique([alumnoId, periodoId])
  @@index([tenantId])
  @@map("comentarios_tutor")
}

/// Criterio del instrumento de una evaluación (rúbrica o lista de cotejo, specs/11). Pertenece a la columna de su
/// competencia y, opcionalmente, a un desempeño. `puntaje`: de 0 a `puntajeMaximo`; `cumple`: sí o no. Los resultados se
/// guardan tal cual: Khipu no los convierte en AD/A/B/C ni en nota (la pone el profesor).
model CriterioEvaluacion {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  evaluacionId  String         @map("evaluacion_id") @db.Uuid
  desempenoId   String?        @map("desempeno_id") @db.Uuid
  descripcion   String
  escala        EscalaCriterio @default(puntaje)
  puntajeMaximo Int?           @map("puntaje_maximo")
  orden         Int            @default(0)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluacion Evaluacion          @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  desempeno  Desempeno?          @relation(fields: [desempenoId], references: [id], onDelete: SetNull)
  resultados ResultadoCriterio[]

  @@index([tenantId])
  @@index([evaluacionId])
  @@map("criterios_evaluacion")
}

/// Resultado de un alumno en un criterio: `puntaje` (escala puntaje) o `cumple` (lista de cotejo).
model ResultadoCriterio {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  criterioId      String   @map("criterio_id") @db.Uuid
  alumnoId        String   @map("alumno_id") @db.Uuid
  puntaje         Decimal? @db.Decimal(5, 2)
  cumple          Boolean?
  registradoPorId String   @map("registrado_por") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criterio      CriterioEvaluacion @relation(fields: [criterioId], references: [id], onDelete: Cascade)
  alumno        Alumno             @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  registradoPor Membership         @relation(fields: [registradoPorId], references: [id], onDelete: NoAction)

  @@unique([criterioId, alumnoId])
  @@index([tenantId])
  @@index([alumnoId])
  @@map("resultados_criterio")
}

/// Cuándo el profesor compartió con las familias el informe de progreso de un curso en un periodo.
model EnvioInformeProgreso {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  cursoId      String   @map("curso_id") @db.Uuid
  periodoId    String   @map("periodo_id") @db.Uuid
  enviadoPorId String   @map("enviado_por") @db.Uuid
  enviadoAt    DateTime @default(now()) @map("enviado_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curso      Curso      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  periodo    Periodo    @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  enviadoPor Membership @relation(fields: [enviadoPorId], references: [id], onDelete: NoAction)

  @@unique([periodoId, cursoId])
  @@index([tenantId])
  @@map("envios_informe_progreso")
}

model Tarea {
  id                   String      @id @default(uuid()) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  /// Curso de origen (el docente la crea desde aquí). Las secciones destino están en `tarea_cursos` (specs/39).
  cursoId              String      @map("curso_id") @db.Uuid
  titulo               String
  descripcion          String?
  /// Fecha límite general (null = sin fecha: nunca vence). Sin hora (`conHora = false`) vence al final de ese día en la zona del colegio.
  fechaEntrega         DateTime?   @map("fecha_entrega") @db.Timestamptz
  conHora              Boolean     @default(false) @map("con_hora")
  estado               EstadoTarea @default(publicada)
  /// Publicación programada: la tarea solo es visible desde este instante.
  publicarEn           DateTime?   @map("publicar_en") @db.Timestamptz
  publicadaAt          DateTime?   @map("publicada_at") @db.Timestamptz
  /// Aviso «tarea publicada» ya enviado (el cron envía el de las programadas cuando llega su hora).
  avisadaAt            DateTime?   @map("avisada_at") @db.Timestamptz
  permiteTardias       Boolean     @default(true) @map("permite_tardias")
  cerradaAt            DateTime?   @map("cerrada_at") @db.Timestamptz
  comentariosGenerales Boolean     @default(false) @map("comentarios_generales")
  calificable          Boolean     @default(false)
  indicacionesEntrega  String?     @map("indicaciones_entrega")
  competenciaId        String?     @map("competencia_id") @db.Uuid
  creadoPorId          String      @map("creado_por") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curso        Curso              @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  creadoPor    Membership         @relation(fields: [creadoPorId], references: [id], onDelete: NoAction)
  competencia  Competencia?       @relation(fields: [competenciaId], references: [id], onDelete: SetNull)
  adjuntos     Archivo[]
  cursos       TareaCurso[]
  asignaciones TareaAsignacion[]
  comentarios  TareaComentario[]
  enlaces      TareaEnlace[]
  cambiosPlazo TareaCambioPlazo[]
  evaluaciones Evaluacion[]
  // @@W1

  // @@W2
  materiales TareaMaterial[]

  // @@W3

  @@index([tenantId, fechaEntrega])
  @@index([tenantId, estado])
  @@map("tareas")
}

/// Sección destino de una tarea (specs/39): un curso «gemelo» del docente en otro salón. `todos` = todo el salón
/// (incluye alumnos que llegan después); si no, solo los alumnos elegidos en `tarea_asignaciones`.
model TareaCurso {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tareaId           String    @map("tarea_id") @db.Uuid
  cursoId           String    @map("curso_id") @db.Uuid
  todos             Boolean   @default(true)
  /// Fecha límite propia de la sección (null = la de la tarea).
  fechaEntrega      DateTime? @map("fecha_entrega") @db.Timestamptz
  /// Evaluación (columna del registro) ligada si la tarea es calificable (specs/11).
  evaluacionGrupoId String?   @map("evaluacion_grupo_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tarea        Tarea              @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  curso        Curso              @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  asignaciones TareaAsignacion[]
  cambiosPlazo TareaCambioPlazo[]

  @@unique([tareaId, cursoId])
  @@index([tenantId, cursoId])
  @@map("tarea_cursos")
}

/// Destinatario individual de una tarea con su estado de entrega (separado del estado de la tarea).
model TareaAsignacion {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  tareaId        String             @map("tarea_id") @db.Uuid
  tareaCursoId   String             @map("tarea_curso_id") @db.Uuid
  alumnoId       String             @map("alumno_id") @db.Uuid
  estado         EstadoEntregaTarea @default(asignada)
  tarde          Boolean            @default(false)
  entregadaAt    DateTime?          @map("entregada_at") @db.Timestamptz
  devueltaAt     DateTime?          @map("devuelta_at") @db.Timestamptz
  revisadaAt     DateTime?          @map("revisada_at") @db.Timestamptz
  /// Destinatario quitado: deja de verla, pero se conservan sus entregas.
  retiradaAt     DateTime?          @map("retirada_at") @db.Timestamptz
  entregadaPorId String?            @map("entregada_por_id") @db.Uuid
  enFisico       Boolean            @default(false) @map("en_fisico")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tarea        Tarea             @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  tareaCurso   TareaCurso        @relation(fields: [tareaCursoId], references: [id], onDelete: Cascade)
  alumno       Alumno            @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  entregadaPor Membership?       @relation("TareaEntregadaPor", fields: [entregadaPorId], references: [id], onDelete: SetNull)
  entregas     TareaEntrega[]
  comentarios  TareaComentario[]

  @@unique([tareaId, alumnoId])
  @@index([tenantId, alumnoId])
  @@index([tareaCursoId])
  @@map("tarea_asignaciones")
}

/// Intento de entrega (reentrega tras devolución = nuevo número). La hora real de envío nunca se recalcula.
model TareaEntrega {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  asignacionId String    @map("asignacion_id") @db.Uuid
  numero       Int
  texto        String?
  borrador     Boolean   @default(true)
  enviadaAt    DateTime? @map("enviada_at") @db.Timestamptz
  tarde        Boolean   @default(false)
  enviadaPorId String?   @map("enviada_por_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asignacion TareaAsignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  enviadaPor Membership?     @relation("TareaEntregaEnviadaPor", fields: [enviadaPorId], references: [id], onDelete: SetNull)
  archivos   Archivo[]

  @@unique([asignacionId, numero])
  @@map("tarea_entregas")
}

/// Comentario de una tarea: `asignacionId` null = general (si la tarea lo permite); con valor = privado docente ↔ alumno/familia.
model TareaComentario {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tareaId      String    @map("tarea_id") @db.Uuid
  asignacionId String?   @map("asignacion_id") @db.Uuid
  autorId      String    @map("autor_id") @db.Uuid
  texto        String
  ocultoAt     DateTime? @map("oculto_at") @db.Timestamptz
  ocultoPorId  String?   @map("oculto_por") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tarea      Tarea            @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  asignacion TareaAsignacion? @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  autor      Membership       @relation("TareaComentarioAutor", fields: [autorId], references: [id], onDelete: NoAction)
  ocultoPor  Membership?      @relation("TareaComentarioOculto", fields: [ocultoPorId], references: [id], onDelete: SetNull)

  @@index([tareaId, asignacionId])
  @@map("tarea_comentarios")
}

model TareaEnlace {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  tareaId  String  @map("tarea_id") @db.Uuid
  url      String
  titulo   String?
  orden    Int     @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tarea  Tarea  @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@index([tareaId])
  @@map("tarea_enlaces")
}

/// Historial inmutable de cambios de plazo (general o de una sección).
model TareaCambioPlazo {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tareaId       String    @map("tarea_id") @db.Uuid
  tareaCursoId  String?   @map("tarea_curso_id") @db.Uuid
  anterior      DateTime? @db.Timestamptz
  nuevo         DateTime? @db.Timestamptz
  motivo        String?
  cambiadoPorId String    @map("cambiado_por") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tarea       Tarea       @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  tareaCurso  TareaCurso? @relation(fields: [tareaCursoId], references: [id], onDelete: Cascade)
  cambiadoPor Membership  @relation("TareaCambioPlazoAutor", fields: [cambiadoPorId], references: [id], onDelete: NoAction)

