model MaterialVersionArchivo {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  versionId String @map("version_id") @db.Uuid
  archivoId String @unique @map("archivo_id") @db.Uuid
  orden Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version MaterialVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  archivo Archivo @relation(fields: [archivoId], references: [id], onDelete: Restrict)

  @@unique([versionId, orden])
  @@map("material_version_archivos")
}

