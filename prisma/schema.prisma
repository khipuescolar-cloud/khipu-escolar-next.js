// Esquema de Khipu Escolar. Documentación por módulo en specs/.
// Toda tabla de negocio lleva tenantId. El acceso pasa SIEMPRE por src/lib/server (db.forTenant).
// RLS está activado en todas las tablas y cerrado para anon/authenticated (ver migración rls_cerrado).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

/// Planes institucionales (specs/03): Khipu Base y Khipu Pro. Se venden completos.
enum Plan {
  base
  pro
}

enum Rol {
  direccion
  profesor
  apoderado
  alumno
  porteria
  administrativo // personal no docente (secretaría, auxiliares, psicología…)
}

enum TipoIdentificacion {
  dni
  ce // carné de extranjería
  pasaporte
}

enum EstadoMembresia {
  activa
  invitada
  inactiva
}

enum EstadoTenant {
  activo
  piloto
  suspendido
}

enum ModoAvisos {
  todos
  solo_excepciones
}

enum EscalaCalificacion {
  literal
  vigesimal
}

/// Si Khipu sugiere la calificación del periodo y cómo (specs/11). Por defecto `ninguna`: el profesor la pone mirando sus
/// notas. `promedio` y `frecuente` son reglas PROVISIONALES (no validadas con docentes) que dirección puede activar.
enum SugerenciaPeriodo {
  ninguna
  promedio
  frecuente

  @@map("CalculoLiteral")
}

/// Estado de una evaluación (specs/11): `programada` = registrada o anunciada; sus notas son borrador y la familia no las ve.
/// `publicada` = resultados visibles para la familia. El cierre del curso o del periodo la deja «cerrada».
enum EstadoEvaluacion {
  programada
  publicada
}

/// Escala de un criterio de un instrumento (rúbrica o lista de cotejo).
enum EscalaCriterio {
  puntaje
  cumple
}

/// Instrumento con que se recoge la evidencia de una evaluación (specs/11).
enum InstrumentoEvaluacion {
  prueba_escrita
  lista_cotejo
  rubrica
  ficha_observacion
  otro
}

enum Nivel {
  inicial
  primaria
  secundaria
  academia
}

enum EstadoAlumno {
  activo
  retirado
}

enum EstadoAsistencia {
  llego
  tarde
  falta
  problema
}

enum OrigenAsistencia {
  lista
  porteria
  automatico // falta del día que pone el control de ingreso (specs/05)
}

enum TipoAviso {
  asistencia
  resumen_llegadas
  mensaje
  comunicado
  invitacion
  justificacion
  tarea
  alerta_direccion
  libreta
  soporte
  reunion // convocatoria, cambio o acta de una reunión (specs/32)
  documento // documento nuevo en la biblioteca (specs/31)
  nudito // Nudito+: licencia, alerta o resumen para la familia (specs/28–29)
}

enum CanalAviso {
  correo
  push
}

enum EstadoAviso {
  pendiente
  enviando // reservado por un worker; evita envíos duplicados
  enviado
  entregado
  abierto
  rebotado
  queja
  error
  omitido
}

/// Para el trato en la interfaz («Tutora» / «Tutor»). Opcional.
enum Genero {
  femenino
  masculino
  no_especifica
}

enum EstadoJustificacion {
  pendiente
  aceptada
  rechazada
}

enum ProveedorArchivo {
  local
  cloudinary
  s3
}

enum TipoPeriodo {
  bimestre
  trimestre
  semestre
}

enum CalificacionLiteral {
  AD
  A
  B
  C
}

enum TipoEvento {
  evento
  reunion
  examen
  feriado
  actividad
}

enum TipoDocumento {
  reglamento
  horario
  calendario
  otro
}

enum AutorNudito {
  usuario
  nudito
}

// ───────────────────────────── Núcleo ─────────────────────────────

model Tenant {
  id                            String             @id @default(uuid()) @db.Uuid
  slug                          String             @unique
  nombre                        String
  ciudad                        String?
  eslogan                       String?
  plan                          Plan               @default(base)
  emailDomains                  String[]           @default([]) @map("email_domains")
  logoArchivoId                 String?            @map("logo_archivo_id") @db.Uuid
  horaEnvioAvisos               String             @default("09:00") @map("hora_envio_avisos") // HH:mm, resumen de llegadas
  horaLimiteTardanza            String             @default("08:00") @map("hora_limite_tardanza") // HH:mm, desde esta hora la llegada es «tarde»
  /// Control de ingreso automático (specs/05): a `horaLimiteTardanza` avisa «aún no llega» a las familias de quienes no
  /// registran ingreso; a `horaLimiteFalta` les pone falta del día con enlace para justificar. Además, en las listas de curso
  /// un alumno sin ingreso al colegio solo puede quedar con falta.
  controlIngresoAutomatico      Boolean            @default(false) @map("control_ingreso_automatico")
  horaLimiteFalta               String             @default("09:00") @map("hora_limite_falta") // HH:mm, desde esta hora sin ingreso = falta
  zonaHoraria                   String             @default("America/Lima") @map("zona_horaria")
  modoAvisos                    ModoAvisos         @default(todos) @map("modo_avisos")
  escalaCalificacion            EscalaCalificacion @default(literal) @map("escala_calificacion")
  sugerenciaPeriodo             SugerenciaPeriodo  @default(ninguna) @map("calculo_literal")
  /// Plazo del reglamento para justificar una falta, en días hábiles (lunes a viernes sin feriados nacionales del Perú) desde el día de la falta.
  plazoJustificacionDiasHabiles Int                @default(15) @map("plazo_justificacion_dias_habiles")
  /// Grado de primaria (1–6) desde el que un alumno puede tener cuenta propia. Secundaria siempre; inicial nunca (specs/10).
  gradoMinimoCuentaAlumno       Int                @default(5) @map("grado_minimo_cuenta_alumno")
  /// Niveles con asistencia por curso (specs/04): los profesores pasan lista de sus cursos solo en salones de estos niveles.
  /// La asistencia al colegio (`ambito = "dia"`: portería o lista del tutor) no depende de esto.
  asistenciaPorCursoNiveles     Nivel[]            @default([]) @map("asistencia_por_curso_niveles")
  estado                        EstadoTenant       @default(activo)
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  memberships           Membership[]
  salones               Salon[]
  cursos                Curso[]
  alumnos               Alumno[]
  apoderadosAlumnos     ApoderadoAlumno[]
  consentimientos       Consentimiento[]
  auditoria             Auditoria[]
  asistencias           Asistencia[]
  controlesIngreso      ControlIngresoDia[]
  enviosAviso           EnvioAviso[]
  avisos                Aviso[]
  justificacionTokens   JustificacionToken[]
  justificaciones       Justificacion[]
  archivos              Archivo[]
  conversaciones        Conversacion[]
  mensajes              Mensaje[]
  comunicados           Comunicado[]
  preferenciasAviso     PreferenciaAviso[]
  carnetsQr             CarnetQr[]
  periodos              Periodo[]
  competencias          Competencia[]
  evaluaciones          Evaluacion[]
  notas                 Nota[]
  calificacionesPeriodo CalificacionPeriodo[]
  tareas                Tarea[]
  eventosAgenda         EventoAgenda[]
  documentosColegio     DocumentoColegio[]
  nuditoConversaciones  NuditoConversacion[]
  nuditoMensajes        NuditoMensaje[]
  exportaciones         ExportacionColegio[]
  accesosSoporte        AccesoSoporte[]
  cierresCurso          CierreCurso[]
  informesProgreso      InformeProgreso[]
  enviosInformeProgreso EnvioInformeProgreso[]
  historialNotas        HistorialNota[]
  comentariosTutor      ComentarioTutor[]
  criteriosEvaluacion   CriterioEvaluacion[]
  resultadosCriterio    ResultadoCriterio[]
  modulosAjustados      TenantModulo[]
  contactos             ContactoColegio[]
  suscripcion           Suscripcion?
  pagos                 PagoRegistro[]
  feriados              FeriadoExtra[]
  ticketsSoporte        TicketSoporte[]
  mensajesSoporte       MensajeSoporte[]
  // Khipu Pro completo (specs/30–33) y Nudito+ (specs/28–29)
  capacidades           Capacidad[]
  desempenos            Desempeno[]
  evaluacionDesempenos  EvaluacionDesempeno[]
  carpetasDocumento     CarpetaDocumento[]
  documentos            Documento[]
  reuniones             Reunion[]
  reunionInvitados      ReunionInvitado[]
  licenciasNudito       LicenciaNudito[]
  pagosNudito           PagoNudito[]
  consentimientosIa     ConsentimientoIa[]
  usosNudito            UsoNudito[]
  alertasNudito         AlertaNudito[]
  resumenesNudito       ResumenNudito[]
  // Horario semanal por salón (specs/34)
  horarioPeriodos       HorarioPeriodo[]
  plantillasHorario     PlantillaHorario[]
  bloquesHorario        BloqueHorario[]

  @@map("tenants")
}

/// Usuario global. id = auth.users.id de Supabase.
model Profile {
  id                  String              @id @db.Uuid
  email               String              @unique
  nombres             String
  apellidos           String              @default("")
  telefono            String?
  genero              Genero?
  tipoDocumento       TipoIdentificacion? @map("tipo_documento")
  numeroDocumento     String?             @map("numero_documento")
  fechaNacimiento     DateTime?           @map("fecha_nacimiento") @db.Date
  direccion           String?
  /// true mientras use la contraseña inicial (su DNI): se le obliga a cambiarla al entrar.
  debeCambiarPassword Boolean             @default(false) @map("debe_cambiar_password")
  ultimoIngresoAt     DateTime?           @map("ultimo_ingreso_at") @db.Timestamptz
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  memberships       Membership[]
  pushSuscripciones PushSuscripcion[]

  adminPlataforma AdminPlataforma?

  @@index([numeroDocumento])
  @@map("profiles")
}

/// Rol de un usuario dentro de un colegio. Un usuario puede tener varias.
model Membership {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  rol       Rol
  estado    EstadoMembresia @default(activa)
  cargo     String? // «Director(a) general», «Secretaria», «Docente de Matemática»…
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  salonesTutor             Salon[]                @relation("TutorSalon")
  cursosDictados           Curso[]                @relation("ProfesorCurso")
  hijos                    ApoderadoAlumno[]
  consentimientos          Consentimiento[]
  asistenciasRegistradas   Asistencia[]           @relation("RegistradoPor")
  enviosCreados            EnvioAviso[]           @relation("EnviosCreados")
  avisos                   Aviso[]
  justificacionTokens      JustificacionToken[]
  justificaciones          Justificacion[]        @relation("JustificacionApoderado")
  justificacionesRevisadas Justificacion[]        @relation("JustificacionRevisor")
  conversacionesProfesor   Conversacion[]         @relation("ConversacionProfesor")
  conversacionesApoderado  Conversacion[]         @relation("ConversacionApoderado")
  mensajes                 Mensaje[]
  comunicados              Comunicado[]
  preferenciaAviso         PreferenciaAviso?
  notasRegistradas         Nota[]
  tareasCreadas            Tarea[]
  eventosCreados           EventoAgenda[]
  nuditoConversaciones     NuditoConversacion[]
  ticketsSoporte           TicketSoporte[]        @relation("TicketsCreados")
  alumnoVinculado          Alumno?                @relation("CuentaAlumno")
  cierresCurso             CierreCurso[]
  informesProgreso         InformeProgreso[]
  enviosInformeProgreso    EnvioInformeProgreso[]
  historialNotas           HistorialNota[]
  comentariosTutor         ComentarioTutor[]
  resultadosCriterio       ResultadoCriterio[]
  carpetasCreadas          CarpetaDocumento[]
  documentosPublicados     Documento[]
  reunionesConvocadas      Reunion[]
  invitacionesReunion      ReunionInvitado[]
  pagosNudito              PagoNudito[]
  consentimientosIa        ConsentimientoIa[]
  bloquesHorarioACargo     BloqueHorario[]

  @@unique([tenantId, userId, rol])
  @@index([userId])
  @@map("memberships")
}

model Salon {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  nombre      String // "3.° B"
  nivel       Nivel
  grado       Int?
  seccion     String?
  anio        Int
  tutorId     String?   @map("tutor_id") @db.Uuid
  /// Salón de un año cerrado: deja de listarse para pasar lista, pero conserva su historial.
  archivadoAt DateTime? @map("archivado_at") @db.Timestamptz
  /// Plantilla de horario (specs/34): horas del día y entrada/salida del salón; su entrada fija la tardanza (specs/05).
  plantillaId String?   @map("plantilla_id") @db.Uuid

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor       Membership?       @relation("TutorSalon", fields: [tutorId], references: [id], onDelete: SetNull)
  plantilla   PlantillaHorario? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  cursos      Curso[]
  alumnos     Alumno[]
  comunicados Comunicado[]
  eventos     EventoAgenda[]
  documentos  Documento[]
  reuniones   Reunion[]
  bloques     BloqueHorario[]

  @@index([tenantId])
  @@map("salones")
}

model Curso {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  salonId    String  @map("salon_id") @db.Uuid
  nombre     String // "Matemática"
  profesorId String? @map("profesor_id") @db.Uuid

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salon                 Salon                  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  profesor              Membership?            @relation("ProfesorCurso", fields: [profesorId], references: [id], onDelete: SetNull)
  asistencias           Asistencia[]
  competencias          Competencia[]
  evaluaciones          Evaluacion[]
  tareas                Tarea[]
  cierres               CierreCurso[]
  enviosInformeProgreso EnvioInformeProgreso[]
  bloques               BloqueHorario[]

  @@index([tenantId])
  @@index([profesorId])
  @@map("cursos")
}

/// El menor NO necesita cuenta propia (se usa desde el grado que fije el colegio).
model Alumno {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  salonId         String       @map("salon_id") @db.Uuid
  nombres         String
  apellidos       String
  codigo          String?
  /// DNI (u otro documento) del alumno, opcional: enlaza a las familias en la carga masiva (specs/36).
  numeroDocumento String?      @map("numero_documento")
  estado          EstadoAlumno @default(activo)
  fotoArchivoId   String?      @map("foto_archivo_id") @db.Uuid
  /// Membresía con rol `alumno` (cuenta propia del estudiante), si tiene.
  cuentaId        String?      @unique @map("cuenta_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuenta                Membership?           @relation("CuentaAlumno", fields: [cuentaId], references: [id], onDelete: SetNull)
  salon                 Salon                 @relation(fields: [salonId], references: [id], onDelete: NoAction)
  apoderados            ApoderadoAlumno[]
  asistencias           Asistencia[]
  conversaciones        Conversacion[]
  carnets               CarnetQr[]
  notas                 Nota[]
  calificacionesPeriodo CalificacionPeriodo[]
  informesProgreso      InformeProgreso[]
  historialNotas        HistorialNota[]
  comentariosTutor      ComentarioTutor[]
  resultadosCriterio    ResultadoCriterio[]
  nuditoConversaciones  NuditoConversacion[]
  invitacionesReunion   ReunionInvitado[]
  licenciasNudito       LicenciaNudito[]
  pagosNudito           PagoNudito[]
  consentimientosIa     ConsentimientoIa[]
  usosNudito            UsoNudito[]
  alertasNudito         AlertaNudito[]
  resumenesNudito       ResumenNudito[]

  @@index([tenantId, salonId])
  @@index([tenantId, numeroDocumento])
  @@map("alumnos")
}

model ApoderadoAlumno {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  apoderadoId      String  @map("apoderado_id") @db.Uuid
  alumnoId         String  @map("alumno_id") @db.Uuid
  parentesco       String  @default("apoderado") // madre, padre, tutor legal…
  recibeAvisos     Boolean @default(true) @map("recibe_avisos")
  consentimientoId String? @map("consentimiento_id") @db.Uuid

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apoderado      Membership      @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)
  alumno         Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  consentimiento Consentimiento? @relation(fields: [consentimientoId], references: [id], onDelete: SetNull)

  @@unique([apoderadoId, alumnoId])
  @@index([tenantId])
  // Índices de rendimiento (docs/pruebas-de-estres.md, migración 20261101090000_indices_rendimiento).
  @@index([alumnoId])
  @@map("apoderados_alumnos")
}

/// Consentimiento versionado del apoderado (Ley 29733). Requerido antes de enviar avisos.
model Consentimiento {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  apoderadoId  String    @map("apoderado_id") @db.Uuid
  versionTexto String    @map("version_texto")
  aceptadoAt   DateTime  @default(now()) @map("aceptado_at") @db.Timestamptz
  ip           String?
  revocadoAt   DateTime? @map("revocado_at") @db.Timestamptz

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apoderado Membership        @relation(fields: [apoderadoId], references: [id], onDelete: Cascade)
  vinculos  ApoderadoAlumno[]

  @@index([tenantId, apoderadoId])
  // Índices de rendimiento (docs/pruebas-de-estres.md, migración 20261101090000_indices_rendimiento).
  @@index([apoderadoId])
  @@map("consentimientos")
}

/// Quién vio o cambió qué.
model Auditoria {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid // profile id
  accion    String // ver | crear | editar | borrar | exportar | enviar
  entidad   String
  entidadId String?  @map("entidad_id")
  detalle   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("auditoria")
}

/// Límite de intentos de login (servidor).
model LoginIntento {
  id        BigInt   @id @default(autoincrement())
  email     String
  ip        String
  exito     Boolean
  /// Solo en ingresos exitosos (sin FK: el registro sobrevive al borrado del perfil).
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("login_intentos")
}

// ───────────────────────── Khipu Base ─────────────────────────

model Asistencia {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  alumnoId        String           @map("alumno_id") @db.Uuid
  cursoId         String?          @map("curso_id") @db.Uuid // null = asistencia del día (portería / tutor)
  ambito          String // = cursoId, o "dia" para la asistencia del día; hace única la fila
  fecha           DateTime         @db.Date
  hora            String // HH:mm, hora local del colegio
  estado          EstadoAsistencia
  nota            String?
  origen          OrigenAsistencia @default(lista)
  registradoPorId String?          @map("registrado_por") @db.Uuid // null = la puso el control de ingreso automático
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alumno          Alumno               @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  curso           Curso?               @relation(fields: [cursoId], references: [id], onDelete: SetNull)
  registradoPor   Membership?          @relation("RegistradoPor", fields: [registradoPorId], references: [id], onDelete: NoAction)
  avisos          Aviso[]
  tokens          JustificacionToken[]
  justificaciones Justificacion[]

  @@unique([alumnoId, fecha, ambito])
  @@index([tenantId, fecha])
  // Índices de rendimiento (docs/pruebas-de-estres.md, migración 20261101090000_indices_rendimiento).
  @@index([cursoId])
  @@index([registradoPorId])
  @@map("asistencias")
}

/// Control de ingreso automático (specs/05): marca qué pasos ya corrieron cada día por colegio, para que el cron
/// avise «aún no llega» y ponga las faltas una sola vez aunque corra cada minuto o haya dos workers a la vez.
model ControlIngresoDia {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  fecha           DateTime  @db.Date
  avisoNoLlegaAt  DateTime? @map("aviso_no_llega_at") @db.Timestamptz
  faltasAt        DateTime? @map("faltas_at") @db.Timestamptz
  avisadosNoLlega Int       @default(0) @map("avisados_no_llega")
  faltas          Int       @default(0)
  /// Grupo de horas: «colegio» (salones sin plantilla, horas de Configuración) o el id de la plantilla de horario.
  clave           String    @default("colegio")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fecha, clave])
  @@map("control_ingreso_dia")
}

/// Un envío = una acción que avisa a familias (cerrar una lista, publicar un comunicado, el «aún no llega» de las 8:00…).
/// Agrupa sus filas de `avisos` para verlas juntas en /avisos (specs/06). `masivo` = llegó a más de una familia
/// (contadas por alumno en asistencia y reuniones, por apoderado en el resto). Escaneos de portería, chat,
/// justificaciones e invitaciones no crean envío: son avisos individuales.
model EnvioAviso {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tipo        TipoAviso
  /// «Lista del día · 3.° B», «Comunicado: Día del juego», «Aún no llega (8:00 a. m.)»…
  titulo      String
  /// Membresía que lo originó; null si lo envió Khipu solo (control de ingreso, recordatorios).
  creadoPorId String?   @map("creado_por") @db.Uuid
  /// Familias distintas a las que llegó (cuántas «unidades» se avisaron).
  familias    Int       @default(0)
  masivo      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creadoPor Membership? @relation("EnviosCreados", fields: [creadoPorId], references: [id], onDelete: SetNull)
  avisos    Aviso[]

  @@index([tenantId, masivo, createdAt])
  @@map("envios_aviso")
}

/// Cola y registro de avisos (correo o push). El worker respeta EMAIL_DAILY_LIMIT.
model Aviso {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  tipo              TipoAviso
  canal             CanalAviso
  asistenciaId      String?     @map("asistencia_id") @db.Uuid
  apoderadoId       String?     @map("apoderado_id") @db.Uuid
  destinatario      String // correo o endpoint push
  plantilla         String
  asunto            String
  payload           Json        @default("{}")
  referenciaId      String?     @map("referencia_id") // conversación, tarea, etc. (para agrupar y limitar avisos)
  envioId           String?     @map("envio_id") @db.Uuid // acción que lo originó (null = aviso individual sin envío)
  providerMessageId String?     @unique @map("provider_message_id")
  estado            EstadoAviso @default(pendiente)
  intentos          Int         @default(0)
  error             String?
  programadoPara    DateTime    @default(now()) @map("programado_para") @db.Timestamptz
  enviadoAt         DateTime?   @map("enviado_at") @db.Timestamptz
  entregadoAt       DateTime?   @map("entregado_at") @db.Timestamptz
  abiertoAt         DateTime?   @map("abierto_at") @db.Timestamptz
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asistencia Asistencia? @relation(fields: [asistenciaId], references: [id], onDelete: SetNull)
  apoderado  Membership? @relation(fields: [apoderadoId], references: [id], onDelete: SetNull)
  envio      EnvioAviso? @relation(fields: [envioId], references: [id], onDelete: SetNull)

  @@index([estado, programadoPara])
  @@index([tenantId, createdAt])
  // Índices de rendimiento (docs/pruebas-de-estres.md, migración 20261101090000_indices_rendimiento).
  @@index([asistenciaId])
  @@index([apoderadoId])
  @@index([canal, enviadoAt])
  @@index([envioId])
  @@map("avisos")
}

/// Enlace «Justificar falta» de un solo uso. Se guarda solo el hash.
